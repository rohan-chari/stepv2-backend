// Cross-worker rate windows for public contest reads and authenticated entry
// attempts. keyHash is either a versioned network HMAC or a one-way user-id
// digest; raw network addresses are never stored.
model GiveawayRateWindow {
  kind        String
  keyHash     String   @map("key_hash")
  windowStart DateTime @map("window_start")
  count       Int
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([kind, keyHash])
  @@index([updatedAt])
  @@map("giveaway_rate_windows")
}

// Payout ledger: which side was paid. Minted at the referee's first qualifying
// race completion (M2). Inserting this row FIRST inside the grant $transaction
// makes the payout exactly-once per human per role across delete+reinstall —
// the @@unique([refereeSubHash, role]) collides before any coin mints. Mirrors
// OnboardingBoxGrant's insert-first idempotency.
//
// userId is nullable + onDelete:SetNull (NOT Cascade) on purpose: the abuse
// ledger MUST outlive the account, exactly like OnboardingBoxGrant (which has no
// user FK at all). If a referee's REFEREE-role row were cascade-deleted on
// account deletion, a delete+reinstall referee would get a fresh refereeSubHash
// slot and could re-farm their own reward (§8.2). SetNull keeps only the hash +
// role (privacy-safe — no PII), preserving the exactly-once guard forever.
// referralId is likewise nullable so a SetNull'd/Cascade-deleted referral keeps
// this audit row. See §4C.
model ReferralRewardGrant {
  id                  String    @id @default(uuid())
  referralId          String?   @map("referral_id")
  userId              String?   @map("user_id") // who received the reward (null after that account is deleted)
  role                String // "REFERRER" | "REFEREE"
  refereeSubHash      String    @map("referee_sub_hash") // abuse key: provider-sub hash of the REFEREE
  coins               Int?
  grantedAt           DateTime  @default(now()) @map("granted_at")
  qualifiedAtSnapshot DateTime? @map("qualified_at_snapshot")

  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([refereeSubHash, role]) // EXACTLY-ONCE PER HUMAN PER ROLE — primary anti-farming guard
  @@index([refereeSubHash])
  @@index([userId])
  @@index([userId, role, qualifiedAtSnapshot])
  @@map("referral_reward_grants")
}

// ── Ranked ─────────────────────────────────────────────────────────────────
// A competitive ladder driven by walking. Each ~monthly Season accrues Ranked
// Points (RP) per user (derived from existing Step rows — see RANKED.md), and a
// background job settles the season: ranks everyone, assigns tiers, mints
// rewards, then opens the next season. All additive — old app versions never
// touch any of this.

enum SeasonStatus {
  ACTIVE   @map("active")
  SETTLING @map("settling")
  CLOSED   @map("closed")
}

model Season {
  id        String       @id @default(uuid())
  index     Int          @unique
  startsAt  DateTime     @map("starts_at")
  endsAt    DateTime     @map("ends_at")
  status    SeasonStatus @default(ACTIVE)
  settledAt DateTime?    @map("settled_at")
  createdAt DateTime     @default(now()) @map("created_at")

  scores SeasonScore[]

  @@index([status])
  @@map("seasons")
}

model SeasonScore {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  seasonId            String   @map("season_id")
  // points = carryOverSeed (soft-reset head start) + earnedPoints (RP from this
  // season's activity). Tiering and the ladder rank on `points`.
  points              Int      @default(0)
  carryOverSeed       Int      @default(0) @map("carry_over_seed")
  earnedPoints        Int      @default(0) @map("earned_points")
  // Provisional standings, refreshed each job tick while the season is live.
  provisionalRank     Int?     @map("provisional_rank")
  provisionalTier     String?  @map("provisional_tier")
  provisionalDivision Int?     @map("provisional_division")
  // Final standings, locked at settlement.
  rank                Int?
  tier                String?
  division            Int?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, points])
  @@map("season_scores")
}

// ── Ranked v2: weekly cohorts ────────────────────────────────────────────────
// Persistent-tier, weekly-cohort ladder (see RANKED_V2.md). Every Monday (date
// axis, matching Step.date semantics) a RankedWeek opens and players are
// grouped into ~30-person same-tier cohorts. Score = raw weekly step total.
// Settlement promotes the top zone, demotes the bottom zone, mints coins, and
// updates User.rankedTierV2 (+ the legacy-mapped User.currentTier for old
// clients). All additive — the legacy Season tables above stay untouched and
// keep serving GET /ranked for shipped app versions.

enum RankedWeekStatus {
  ACTIVE   @map("active")
  SETTLING @map("settling")
  CLOSED   @map("closed")
}

model RankedWeek {
  id        String           @id @default(uuid())
  index     Int              @unique
  // Half-open [startsOn, endsOn) on the UTC-midnight date axis (Mon..next Mon).
  startsOn  DateTime         @map("starts_on")
  endsOn    DateTime         @map("ends_on")
  status    RankedWeekStatus @default(ACTIVE)
  settledAt DateTime?        @map("settled_at")
  createdAt DateTime         @default(now()) @map("created_at")

  cohorts RankedCohort[]
  members RankedCohortMember[]

  @@index([status])
  @@map("ranked_weeks")
}

model RankedCohort {
  id        String   @id @default(uuid())
  weekId    String   @map("week_id")
  tier      String // BRONZE | SILVER | GOLD | PLATINUM | DIAMOND | LEGEND
  createdAt DateTime @default(now()) @map("created_at")

  week    RankedWeek           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  members RankedCohortMember[]

  @@index([weekId, tier])
  @@map("ranked_cohorts")
}

model RankedCohortMember {
  id              String    @id @default(uuid())
  // weekId is denormalized from the cohort so (weekId, userId) can be unique:
  // one cohort per user per week.
  weekId          String    @map("week_id")
  cohortId        String    @map("cohort_id")
  userId          String    @map("user_id")
  // Home tier at assignment (the cohort's tier; kept per-member so history
  // survives cohort deletion/rebalance).
  tier            String
  // Live score: raw step total for the week, refreshed each job tick.
  weeklySteps     Int       @default(0) @map("weekly_steps")
  provisionalRank Int?      @map("provisional_rank")
  // Settlement results, locked once the week closes.
  finalRank       Int?      @map("final_rank")
  outcome         String? // PROMOTE | HOLD | DEMOTE
  resultTier      String?   @map("result_tier") // home tier after settlement
  rewardCoins     Int?      @map("reward_coins")
  promotionCoins  Int?      @map("promotion_coins")
  // Display-only ack: set when the user has seen the post-settlement summary
  // popup for this week. NULL = unseen. Additive; old app builds never read it.
  resultsSeenAt   DateTime? @map("results_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort RankedCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  week   RankedWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, userId])
  @@index([cohortId, weeklySteps])
  @@map("ranked_cohort_members")
}

// BeReal-style global step-multiplier event. During [startsAt, endsAt) steps
// taken by ALL participants in ALL active races are multiplied by `multiplier`
// (stacking multiplicatively with per-participant powerup multipliers). Created
// ~3x/day by the scheduler (src/jobs/globalStepEventScheduler.js); read by the
// SHARED resolution so display (getRaceProgress) and settlement (raceExpiry)
// agree. Additive, never read by old app binaries (which simply see a higher,
// correct step total during a window).
model GlobalStepEvent {
  id                        String   @id @default(uuid())
  startsAt                  DateTime @map("starts_at")
  endsAt                    DateTime @map("ends_at")
  multiplier                Float    @default(2)
  label                     String?
  scheduleMode              String   @default("LEGACY_GLOBAL") @map("schedule_mode")
  eventDay                  String?  @unique @map("event_day")
  localStartMinute          Int?     @map("local_start_minute")
  durationMinutes           Int?     @map("duration_minutes")
  schedulePolicyVersion     Int?     @map("schedule_policy_version")
  summaryAttributionVersion Int      @default(1) @map("summary_attribution_version")
  createdAt                 DateTime @default(now()) @map("created_at")

  raceImpacts      GlobalEventRaceImpact[]
  userSummaries    GlobalEventUserSummary[]
  entitlements     GlobalStepEventEntitlement[]
  summaryWork      GlobalEventSummaryWork[]
  captureArtifacts GlobalEventCaptureArtifact[]

  @@index([startsAt, endsAt])
  @@map("global_step_events")
}

model GlobalStepEventEntitlement {
  id                    String    @id @default(uuid())
  eventId               String    @map("event_id")
  userId                String    @map("user_id")
  timezone              String
  localDate             String    @map("local_date")
  startsAt              DateTime  @map("starts_at")
  endsAt                DateTime  @map("ends_at")
  startOutcome          String    @default("PENDING") @map("start_outcome")
  startProcessedAt      DateTime? @map("start_processed_at")
  endProcessedAt        DateTime? @map("end_processed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  timezoneRelocatedAt   DateTime? @map("timezone_relocated_at")
  timezoneRelocatedFrom String?   @map("timezone_relocated_from")
  scheduleRevision      Int       @default(0) @map("schedule_revision")
  startAttemptCount     Int       @default(0) @map("start_attempt_count")
  startNextAttemptAt    DateTime? @map("start_next_attempt_at")
  startLastErrorCode    String?   @map("start_last_error_code")
  startFailedAt         DateTime? @map("start_failed_at")

  event GlobalStepEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([startsAt, startProcessedAt])
  @@index([startsAt, id], map: "global_step_event_entitlements_due_start_idx")
  @@index([startNextAttemptAt, startsAt, id], map: "global_step_event_entitlements_retry_start_idx")
  @@index([endsAt, endProcessedAt])
  @@index([userId, startsAt, endsAt])
  @@map("global_step_event_entitlements")
}

// Durable mixed-generation scheduler census. Local parent creation is refused
// unless the configured owner count is alive and every owner advertises the
// local-aware generation; maintenance of existing parents is never gated.
model GlobalStepEventCronOwner {
  ownerId        String   @id @map("owner_id")
  generation     Int
  localAware     Boolean  @default(false) @map("local_aware")
  heartbeatAt    DateTime @map("heartbeat_at")
  expiresAt      DateTime @map("expires_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  logicalOwnerId String?  @map("logical_owner_id")
  bootId         String?  @map("boot_id")
  role           String?
  capabilities   Json     @default("[]")

  @@unique([logicalOwnerId, bootId])
  @@index([expiresAt])
  @@index([generation, expiresAt, logicalOwnerId, bootId])
  @@map("global_step_event_cron_owners")
}

model GlobalStepEventGenerationState {
  id                  Int       @id @default(1)
  requiredGeneration  Int       @default(2) @map("required_generation")
  readySince          DateTime? @map("ready_since")
  quarantineStartedAt DateTime? @map("quarantine_started_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("global_step_event_generation_state")
}

model GlobalStepEventOperationalSnapshot {
  id                    String   @id @default(uuid())
  observedAt            DateTime @map("observed_at")
  dueStarts             Int      @map("due_starts")
  dueEnds               Int      @map("due_ends")
  stalePendingStarts    Int      @map("stale_pending_starts")
  invalidLocalParents   Int      @map("invalid_local_parents")
  activeParents         Int      @map("active_parents")
  activeEntitlements    Int      @map("active_entitlements")
  exposureZeroRaces     Int      @map("exposure_zero_races")
  exposureOneRaces      Int      @map("exposure_one_races")
  exposureMultipleRaces Int      @map("exposure_multiple_races")
  exposureBuckets       Json     @default("{}") @map("exposure_buckets")
  entitlementsByOffset  Json     @default("{}") @map("entitlements_by_offset")
  rolloutCounters       Json     @default("{}") @map("rollout_counters")
  healthy               Boolean
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([observedAt(sort: Desc)])
  @@map("global_step_event_operational_snapshots")
}

// Monotonic durable counters for rollout events that cannot be reconstructed
// from current lifecycle rows (candidate promotions, duplicate suppression,
// and scoring-query latency). Snapshots copy these into aggregate JSON.
model GlobalStepEventOperationalCounter {
  metric    String   @id
  value     BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("global_step_event_operational_counters")
}

// Cluster-owned durable cursor for global-event start/end boundary delivery.
// A due boundary remains pending until every active race has a durable FULL
// enqueue; expired leases are safely reclaimable after process loss.
model GlobalStepEventBoundaryCursor {
  key            String    @id
  boundaryAt     DateTime  @map("boundary_at")
  eventId        String    @map("event_id")
  boundaryKind   String    @map("boundary_kind") @db.VarChar(8)
  leaseExpiresAt DateTime? @map("lease_expires_at")
  leaseToken     String?   @map("lease_token")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([leaseExpiresAt])
  @@map("global_step_event_boundary_cursors")
}

// Audit log of every user-facing (visible) push we send. Written at each visible
// send site in notificationHandlers.js; silent refresh pushes are NOT recorded.
// `type` is a free-form String (the push payload's `type`, e.g. RACE_STARTED,
// race_message, PLACEMENT_CHANGED, DAILY_MOVER) rather than an enum, so new
// notification kinds don't need a migration. A nightly job prunes rows older than
// a week. Storage-only for now (queried directly when debugging); no API exposes
// it, so old clients are unaffected.
model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  title       String?
  body        String?
  raceId      String?  @map("race_id")
  // Cross-process atomic-claim key for the daily-reward reminder scheduler
  // (§7). The job INSERTs a deterministic key (daily-reward:<userId>:<localDate>:<slot>)
  // BEFORE sending and only sends on a successful insert, so two cluster workers
  // can never double-send. Null for EVERY other writer. The unique index is
  // PARTIAL (WHERE delivery_key IS NOT NULL) — see the migration SQL; the
  // @unique here is what keeps Prisma's index name stable, the migration adds the
  // predicate. Postgres treats nulls as distinct, so existing null writers never
  // collide regardless.
  deliveryKey String?  @unique @map("delivery_key")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// Once-per-day idempotency marker for ET-anchored cron jobs (notification
// cleanup @1am ET, daily-mover digest @4pm ET). `lastRanFor` stores the ET
// calendar day (YYYY-MM-DD) the job last completed for, so a job fires exactly
// once per ET day even across the frequent process restarts and regardless of
// DST. Keyed by job name; one row per job.
model JobRun {
  jobName    String   @id @map("job_name")
  lastRanFor String   @map("last_ran_for")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("job_runs")
}

// Runtime feature flags / app settings, toggleable from the admin screen
// without a deploy. One row per key; value is free-form JSON so new flags
// don't need a migration. Read through src/services/appSettings.js (cached).
// Per-environment by design (prod and staging flip independently — unlike
// shop items, settings are NOT mirrored to the peer DB).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Versioned, append-only game-balance configuration (rarity, drop pools,
// position-odds curves, upgrade ladders, daily-box curves). Exactly one row has
// active = true; every save writes a NEW row rather than mutating an old one,
// so history is a full audit trail and rollback is a copy-forward.
//
// `version` is assigned by the APPLICATION inside the write transaction
// (SELECT ... FOR UPDATE on the newest row), NOT by @default(autoincrement()) —
// Prisma only supports autoincrement on @id for this connector.
//
// Per-environment on purpose (D3): prod and staging are tuned independently and
// nothing is mirrored, so staging stays usable as a balance test bed.
model BalanceConfig {
  id            String   @id @default(uuid())
  version       Int      @unique
  config        Json
  note          String?
  createdBy     String?  @map("created_by")
  boundOverride Boolean  @default(false) @map("bound_override")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([active])
  @@map("balance_config")
}

// Top-of-funnel tap log for /r/<token> landing-page opens (referral codes and
// race share links). One row per page view; feeds the invite-funnel numbers in
// GET /admin/stats. Append-only, no user linkage (the viewer is anonymous).
model LinkOpen {
  id               String   @id @default(uuid())
  kind             String // "referral" | "race_share"
  code             String? // normalized referral code, or the race share token
  sourceRaceId     String?  @map("source_race_id")
  // SHA-256 hash of the viewer's client IP (never the raw IP — the viewer is
  // anonymous and stays that way). Powers IP-correlated deferred referral
  // attribution: a codeless signup from the same hashed IP within the fallback
  // window attributes to the code opened here. Nullable/additive — old rows and
  // opens with no resolvable IP simply never match.
  ipHash           String?  @map("ip_hash")
  // SHA-256 hash of the viewer's NETWORK PREFIX (IPv4 /24, IPv6 /64) — tier 2
  // of the two-tier fallback. The exact-IP match breaks whenever the landing
  // page and the app egress from different addresses on the same network
  // (IPv4<->IPv6, Wi-Fi<->cellular, NAT churn); the prefix survives that.
  // Same privacy posture as ipHash: only the hash is ever persisted.
  //
  // Nullable/additive. Old rows stay NULL and age out of the 48h window within
  // two days of deploy, so no backfill. A NULL here must NEVER be used as a
  // match key — `where: { ipNetHash: null }` would match every legacy row at
  // once; findLinkOpenReferralCode skips tier 2 entirely on a null hash.
  ipNetHash        String?  @map("ip_net_hash")
  ipHashVersion    Int?     @map("ip_hash_version")
  ipNetHashVersion Int?     @map("ip_net_hash_version")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([ipHash, createdAt])
  @@index([ipNetHash, createdAt])
  @@map("link_opens")
}

model UserActivityDay {
  userId             String   @map("user_id")
  activityDate       DateTime @map("activity_date") @db.Date
  firstSeenAt        DateTime @map("first_seen_at")
  lastSeenAt         DateTime @map("last_seen_at")
  appVersion         String   @map("app_version")
  source             String   @default("foreground")
  metadataOccurredAt DateTime @map("metadata_occurred_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, activityDate])
  @@index([activityDate])
  @@map("user_activity_days")
}

model AdminMetricsCollectionEpoch {
  id        String    @id @default(uuid())
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@index([startedAt, endedAt])
  @@map("admin_metrics_collection_epochs")
}

model MetricCoverageStart {
  metric        String   @id
  operationalAt DateTime @map("operational_at")
  confirmedAt   DateTime @default(now()) @map("confirmed_at")

  @@map("metric_coverage_starts")
}

model PushDelivery {
  id                 String    @id @default(uuid())
  publicId           String    @unique @map("public_id")
  deliveryKey        String    @unique @map("delivery_key")
  userId             String    @map("user_id")
  notificationType   String    @map("notification_type")
  openCapable        Boolean   @map("open_capable")
  createdAt          DateTime  @default(now()) @map("created_at")
  providerAcceptedAt DateTime? @map("provider_accepted_at")
  openedAt           DateTime? @map("opened_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerAcceptedAt, notificationType])
  @@index([userId, createdAt])
  @@map("push_deliveries")
}

model AnalyticsCleanupRun {
  id             String    @id @default(uuid())
  jobKey         String    @map("job_key")
  dayKey         DateTime  @map("day_key") @db.Date
  state          String
  fence          BigInt    @default(1)
  leaseOwner     String    @map("lease_owner")
  leaseExpiresAt DateTime  @map("lease_expires_at")
  cursor         String?
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([jobKey, dayKey])
  @@index([state, leaseExpiresAt])
  @@map("analytics_cleanup_runs")
}

// ── Android waitlist (marketing site) ────────────────────────────────────────
// Email capture from barastep.com's "Android — join the waitlist" form. Written
// only by the public, unauthenticated POST /waitlist/android; never read by the
// app (retrieval is a direct DB query). Purely additive — no existing model or
// column is touched, so a mixed-version deploy is a non-event.
//
// `email` is stored NORMALIZED (trimmed + lowercased by the command layer) and
// is @unique: that pair is what makes a resubmission idempotent instead of an
// error, and it's why Person@Example.com can't occupy a second row.
model AndroidWaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("android_waitlist_entries")
}

// ── Async step sync (Home/Races Refresh Performance) ─────────────────────────
// Two ADDITIVE tables backing POST /steps/sync-v2 and the durable race-
// resolution worker. Old backend code ignores them; old app builds never call
// the v2 endpoint (they keep POST /steps + POST /steps/samples). Nothing here
// removes or changes an existing column, so a mixed-version deploy is safe.

// Server-side idempotency reservation for one sync-v2 attempt group. Keyed by
// (userId, idempotencyKey): the first valid request persists data and stores its
// canonical response; a same-hash replay reads the stored response; a different-
// hash reuse of the key is a 409 conflict. `requestHash` is the SHA-256 hex of
// the canonical request. `resolutionTimeZone` persists the validated request tz
// so recovery/finalization never has to re-derive it. Rows retain ~7 days.
enum StepSyncRequestState {
  PROCESSING @map("processing")
  COMPLETE   @map("complete")
}

model StepSyncRequest {
  id                       String               @id @default(uuid())
  userId                   String               @map("user_id")
  idempotencyKey           String               @map("idempotency_key") @db.VarChar(36)
  requestHash              String               @map("request_hash") @db.Char(64)
  resolutionTimeZone       String               @map("resolution_time_zone") @db.VarChar(255)
  state                    StepSyncRequestState @default(PROCESSING)
  responseJson             Json?                @map("response_json")
  // Non-null while an owner is performing canonical source intake; an expired
  // lease is reclaimable for idempotent recovery.
  leaseExpiresAt           DateTime?            @map("lease_expires_at")
  // Set exactly once, under a conditional `eventsEmittedAt IS NULL` claim, so a
  // replay/recovery can never re-emit STEPS_RECORDED/STEPS_UPDATED.
  eventsEmittedAt          DateTime?            @map("events_emitted_at")
  // Locked classification captured by canonical intake. Together with a null
  // eventsEmittedAt this is the durable STEPS_* event intent a COMPLETE replay
  // can safely claim after a process crash between commit and after-commit work.
  dailyExisted             Boolean?             @map("daily_existed")
  // Canonical intake's crash-safe no-op classification. Null is the mixed-version
  // fail-closed value and always means "enqueue".
  scoringChanged           Boolean?             @map("scoring_changed")
  completedAt              DateTime?            @map("completed_at")
  canonicalCoverageThrough DateTime?            @map("canonical_coverage_through")
  scoringInputGeneration   BigInt?              @map("scoring_input_generation")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  expiresAt                DateTime             @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([expiresAt])
  @@map("step_sync_requests")
}

// One durable full-field race-resolution job PER USER (unique userId). Enqueue
// is an upsert that bumps `generation` and sets QUEUED; the worker claims rows
// with FOR UPDATE SKIP LOCKED, snapshots the generation + tz into
// processingGeneration/processingTimeZone, and only records success when the
// claimed generation still matches. A newer generation supersedes an older
// polled one. `resolutionTimeZone`/`processingTimeZone` are the validated IANA
// request tz — the worker NEVER infers tz from server locale/UTC.
enum RaceResolutionJobState {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
}

enum RacePlacementTransitionJobState {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  RETRY     @map("retry")
  SUCCEEDED @map("succeeded")
}

model RaceResolutionJob {
  id                   String                 @id @default(uuid())
  userId               String                 @unique @map("user_id")
  generation           Int                    @default(1)
  processingGeneration Int?                   @map("processing_generation")
  resolutionTimeZone   String                 @map("resolution_time_zone") @db.VarChar(255)
  processingTimeZone   String?                @map("processing_time_zone") @db.VarChar(255)
  state                RaceResolutionJobState @default(QUEUED)
  attempts             Int                    @default(0)
  requestedAt          DateTime               @map("requested_at")
  startedAt            DateTime?              @map("started_at")
  completedAt          DateTime?              @map("completed_at")
  retryAt              DateTime?              @map("retry_at")
  leaseExpiresAt       DateTime?              @map("lease_expires_at")
  lastErrorCode        String?                @map("last_error_code")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, retryAt])
  @@index([leaseExpiresAt])
  @@map("race_resolution_jobs")
}

// C0 (Redis derived-data spec §5a) — the RACE-KEYED resolution queue. One row
// per race (unique raceId): the worker that claims it is the SOLE bulk writer of
// that race's race_participants rows, and raceExpiry acquires the same row
// FOR UPDATE before settling, so a live resolve and a settlement can never both
// be mid-write on one race.
//
// EXPAND phase: this table is created ALONGSIDE the old per-user
// `race_resolution_jobs`, which is left completely untouched so old binaries
// draining it during a `pm2 reload` overlap never see a schema they don't
// expect. The contract migration (drop old table) ships >= 1 week later.
//
// Extra columns over v1:
//  - leaseToken                   fencing token minted at claim; the write
//                                 transaction re-acquires the row
//                                 `WHERE id = ? AND lease_token = ?` FOR UPDATE
//                                 BEFORE touching any participant row.
//  - notBeforeAt                  explicit debounce floor written by
//                                 recordSuccess (now + RACE_RESOLVE_DEBOUNCE_MS).
//  - triggeredByUserIds           append-distinct list of users whose enqueue
//                                 made this race dirty (box state / nudges).
//  - processingTriggeredByUserIds snapshot moved over at claim; survives a
//                                 crash so a re-claim UNIONs it back in and no
//                                 triggering user is ever dropped.
//  - lastCompletedAt              last successful resolve (debounce/observability).
model RaceResolutionJobV2 {
  id                              String                 @id @default(uuid())
  raceId                          String                 @unique @map("race_id")
  generation                      Int                    @default(1)
  processingGeneration            Int?                   @map("processing_generation")
  resolutionTimeZone              String?                @map("resolution_time_zone") @db.VarChar(255)
  processingTimeZone              String?                @map("processing_time_zone") @db.VarChar(255)
  state                           RaceResolutionJobState @default(QUEUED)
  attempts                        Int                    @default(0)
  requestedAt                     DateTime               @map("requested_at")
  startedAt                       DateTime?              @map("started_at")
  completedAt                     DateTime?              @map("completed_at")
  lastCompletedAt                 DateTime?              @map("last_completed_at")
  retryAt                         DateTime?              @map("retry_at")
  notBeforeAt                     DateTime?              @map("not_before_at")
  leaseExpiresAt                  DateTime?              @map("lease_expires_at")
  leaseToken                      String?                @map("lease_token")
  lastErrorCode                   String?                @map("last_error_code")
  triggeredByUserIds              Json                   @default("[]") @map("triggered_by_user_ids")
  processingTriggeredByUserIds    Json                   @default("[]") @map("processing_triggered_by_user_ids")
  dirtyReasons                    Json                   @default("[]") @map("dirty_reasons")
  dirtyParticipantIds             Json                   @default("[]") @map("dirty_participant_ids")
  dirtyPowerupTypes               Json                   @default("[]") @map("dirty_powerup_types")
  dirtyPriority                   String                 @default("IMMEDIATE") @map("dirty_priority") @db.VarChar(16)
  // Durable queue priority is separate from the legacy dirty-priority field.
  // The latter remains COALESCE/IMMEDIATE for old workers and diagnostics;
  // this field orders the race-keyed queue across live, recovery, settlement,
  // and maintenance work.
  queuePriority                   String                 @default("LIVE") @map("queue_priority") @db.VarChar(16)
  processingDirtyReasons          Json                   @default("[]") @map("processing_dirty_reasons")
  processingDirtyParticipantIds   Json                   @default("[]") @map("processing_dirty_participant_ids")
  processingDirtyPowerupTypes     Json                   @default("[]") @map("processing_dirty_powerup_types")
  processingDirtyPriority         String                 @default("IMMEDIATE") @map("processing_dirty_priority") @db.VarChar(16)
  processingQueuePriority         String                 @default("LIVE") @map("processing_queue_priority") @db.VarChar(16)
  displayArtifactId               String?                @map("display_artifact_id")
  displayArtifactDigest           String?                @map("display_artifact_digest") @db.VarChar(64)
  displayArtifactSchema           Int?                   @map("display_artifact_schema")
  processingDisplayArtifactId     String?                @map("processing_display_artifact_id")
  processingDisplayArtifactDigest String?                @map("processing_display_artifact_digest") @db.VarChar(64)
  processingDisplayArtifactSchema Int?                   @map("processing_display_artifact_schema")
  createdAt                       DateTime               @default(now()) @map("created_at")
  updatedAt                       DateTime               @updatedAt @map("updated_at")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([state, retryAt])
  @@index([leaseExpiresAt])
  @@index([state, notBeforeAt])
  @@index([state, queuePriority, requestedAt])
  @@index([requestedAt])
  @@map("race_resolution_jobs_v2")
}

// Constant-size, durable handoff from one committed race-resolution generation
// to independently retryable placement/event materialization. One row per
// race coalesces newer generations while retaining the current lease owner.
model RacePlacementTransitionJob {
  id                   String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raceId               String                          @unique @map("race_id")
  requestedGeneration  Int                             @map("requested_generation")
  processingGeneration Int?                            @map("processing_generation")
  completedGeneration  Int?                            @map("completed_generation")
  state                RacePlacementTransitionJobState @default(QUEUED)
  requestedAt          DateTime                        @map("requested_at")
  observedAt           DateTime                        @map("observed_at")
  processingObservedAt DateTime?                       @map("processing_observed_at")
  notBeforeAt          DateTime                        @map("not_before_at")
  attempts             Int                             @default(0)
  retryAt              DateTime?                       @map("retry_at")
  startedAt            DateTime?                       @map("started_at")
  completedAt          DateTime?                       @map("completed_at")
  lastCompletedAt      DateTime?                       @map("last_completed_at")
  leaseToken           String?                         @map("lease_token") @db.VarChar(64)
  leaseExpiresAt       DateTime?                       @map("lease_expires_at")
  lastErrorCode        String?                         @map("last_error_code") @db.VarChar(128)
  createdAt            DateTime                        @default(now()) @map("created_at")
  updatedAt            DateTime                        @default(now()) @updatedAt @map("updated_at")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([state, notBeforeAt, retryAt, requestedAt, raceId], map: "race_placement_transition_jobs_claim_idx")
  @@index([state, leaseExpiresAt], map: "race_placement_transition_jobs_expired_lease_idx")
  @@map("race_placement_transition_jobs")
}

model UserScoringInputVersion {
  userId                         String    @id @map("user_id")
  generation                     BigInt    @default(1)
  sourceQueueSemanticsGeneration BigInt?   @map("source_queue_semantics_generation")
  scoringWatermark               String?   @map("scoring_watermark") @db.Char(64)
  nextSampleBoundaryAt           DateTime? @map("next_sample_boundary_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_scoring_input_versions")
}

model RaceResolutionPostTask {
  id                  String    @id @default(uuid())
  raceId              String    @map("race_id")
  sourceGeneration    Int       @map("source_generation")
  dedupeKey           String    @unique @map("dedupe_key")
  state               String    @default("queued") @db.VarChar(32)
  requestedAt         DateTime  @map("requested_at")
  notBeforeAt         DateTime  @map("not_before_at")
  snapshotState       String    @default("pending") @map("snapshot_state") @db.VarChar(32)
  snapshotAttemptId   String?   @map("snapshot_attempt_id")
  snapshotAttemptedAt DateTime? @map("snapshot_attempted_at")
  snapshotCompletedAt DateTime? @map("snapshot_completed_at")
  snapshotErrorCode   String?   @map("snapshot_error_code")
  snapshotCommand     Json      @map("snapshot_command")
  payloadBytes        Int       @map("payload_bytes")
  intentCount         Int       @map("intent_count")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  leaseToken          String?   @map("lease_token")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  race    Race                           @relation(fields: [raceId], references: [id], onDelete: Cascade)
  intents RaceResolutionDeliveryIntent[]

  @@unique([raceId, sourceGeneration])
  @@index([state, notBeforeAt])
  @@index([leaseExpiresAt])
  @@index([raceId, sourceGeneration])
  @@index([state, completedAt, id])
  @@map("race_resolution_post_tasks")
}

model RaceResolutionDeliveryIntent {
  id                  String    @id @default(uuid())
  taskId              String    @map("task_id")
  ordinal             Int
  kind                String    @db.VarChar(32)
  recipientUserId     String?   @map("recipient_user_id")
  payload             Json
  payloadBytes        Int       @map("payload_bytes")
  deliveryKeyHash     String    @unique @map("delivery_key_hash")
  cooldownClaimId     String?   @map("cooldown_claim_id")
  state               String    @default("pending") @db.VarChar(32)
  attemptId           String?   @map("attempt_id")
  attemptedAt         DateTime? @map("attempted_at")
  completedAt         DateTime? @map("completed_at")
  providerDisposition String?   @map("provider_disposition")
  lastErrorCode       String?   @map("last_error_code")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  task          RaceResolutionPostTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipientUser User?                  @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, ordinal])
  @@index([taskId, state, ordinal])
  @@index([state, attemptedAt])
  @@map("race_resolution_delivery_intents")
}

// Generic, append-only durable handoff from committed domain facts to
// independently retryable notification projection. Domain producers write
// only this envelope and occurrence-time audience facts; notification code
// owns every mutable projection/delivery concern downstream.
model DomainEventOutbox {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventKey             String    @unique @map("event_key") @db.VarChar(255)
  eventType            String    @map("event_type") @db.VarChar(96)
  schemaVersion        Int       @default(1) @map("schema_version")
  aggregateType        String    @map("aggregate_type") @db.VarChar(64)
  aggregateId          String    @map("aggregate_id") @db.VarChar(191)
  payload              Json
  occurredAt           DateTime  @map("occurred_at")
  availableAt          DateTime  @map("available_at")
  status               String    @default("PENDING") @db.VarChar(32)
  expansionCursor      String?   @map("expansion_cursor") @db.VarChar(191)
  expansionCompletedAt DateTime? @map("expansion_completed_at")
  leaseToken           String?   @map("lease_token") @db.VarChar(64)
  leaseUntil           DateTime? @map("lease_until")
  attemptCount         Int       @default(0) @map("attempt_count")
  lastErrorCode        String?   @map("last_error_code") @db.VarChar(128)
  lastErrorAt          DateTime? @map("last_error_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  audience    DomainEventAudience[]
  projections DomainEventNotificationProjection[]

  @@index([status, availableAt, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([leaseToken])
  @@map("domain_event_outbox")
}

model DomainEventAudience {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainEventId String   @map("domain_event_id") @db.Uuid
  recipientId   String   @map("recipient_id") @db.VarChar(191)
  ordinal       Int
  facts         Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  event DomainEventOutbox @relation(fields: [domainEventId], references: [id], onDelete: Cascade)

  @@unique([domainEventId, recipientId])
  @@unique([domainEventId, ordinal])
  @@index([domainEventId, ordinal])
  @@map("domain_event_audiences")
}

model DomainEventNotificationProjection {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainEventId   String    @map("domain_event_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.VarChar(191)
  deliveryKey     String    @map("delivery_key") @db.VarChar(255)
  projectionKind  String    @map("projection_kind") @db.VarChar(32)
  status          String    @default("PENDING") @db.VarChar(32)
  availableAt     DateTime  @map("available_at")
  leaseToken      String?   @map("lease_token") @db.VarChar(64)
  leaseUntil      DateTime? @map("lease_until")
  attemptCount    Int       @default(0) @map("attempt_count")
  lastErrorCode   String?   @map("last_error_code") @db.VarChar(128)
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  event DomainEventOutbox @relation(fields: [domainEventId], references: [id], onDelete: Cascade)

  @@unique([domainEventId, recipientUserId, deliveryKey, projectionKind], map: "domain_event_notification_projections_event_recipient_delivery_")
  @@index([status, availableAt, id], map: "domain_event_notification_projections_status_available_at_id_id")
  @@index([leaseToken])
  @@map("domain_event_notification_projections")
}
