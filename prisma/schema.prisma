generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                String                          @id @default(uuid())
  // Auth identity is single-provider per user: Apple (iOS) OR Google (Android).
  // Both are nullable+unique so a pure-Google user has no appleId and vice versa.
  // Postgres unique indexes allow multiple NULLs, so many users can share a null
  // on either column. Existing Apple rows are untouched. See ANDROID.md §G1.
  appleId                           String?                         @unique @map("apple_id")
  googleSub                         String?                         @unique @map("google_sub")
  email                             String?
  name                              String?
  displayName                       String?                         @unique @map("display_name")
  // Explicit discoverable identity. Provider `name` is intentionally not
  // repurposed: these fields are written only after the user reviews the
  // in-product disclosure. All nullable so mixed-version deploys and existing
  // rows are safe. Completion — not field presence — controls disclosure.
  firstName                         String?                         @map("first_name")
  lastName                          String?                         @map("last_name")
  discoverableNameSearch            String?                         @map("discoverable_name_search")
  nameSetupOnboardingRequired       Boolean                         @default(false) @map("name_setup_onboarding_required")
  nameSetupCompletedAt              DateTime?                       @map("name_setup_completed_at")
  profilePhotoUrl                   String?                         @map("profile_photo_url")
  profilePhotoKey                   String?                         @map("profile_photo_key")
  profilePhotoPromptDismissedAt     DateTime?                       @map("profile_photo_prompt_dismissed_at")
  // Home SETUP section: how many times the "you can rename yourself" chip has
  // been shown to this ACCOUNT, and when the user retired it. Previously lived
  // in device-scoped SharedPreferences, which signOut() wipes — so the chip came
  // back on every sign-out/sign-in cycle. Additive/back-compat: NOT NULL DEFAULT
  // 0 and nullable timestamp, so old clients (which never read or write these)
  // are unaffected, and no backfill is performed (every existing row starts
  // eligible). See docs/home-setup-section-requirements.md §5.
  renameChipShownCount              Int                             @default(0) @map("rename_chip_shown_count")
  renameChipDismissedAt             DateTime?                       @map("rename_chip_dismissed_at")
  // Deprecated: step goals are no longer part of the product. Kept
  // nullable for back-compat with existing rows. New code must not read
  // or write this field.
  stepGoal                          Int?                            @map("step_goal")
  lastStepSyncAt                    DateTime?                       @map("last_step_sync_at")
  // Authoritative, cross-device cooldown stamp for explicitly opt-in Home
  // pull-to-refresh syncs. Nullable/additive: existing users and every frozen
  // client retain the pre-cooldown behavior until a capable client sends the
  // exact intent header.
  lastHomePullStepSyncAt            DateTime?                       @map("last_home_pull_step_sync_at")
  lastSilentPushSentAt              DateTime?                       @map("last_silent_push_sent_at")
  coins                             Int                             @default(0)
  lastDailyClaimDate                String?                         @map("last_daily_claim_date")
  dailyStreakDay                    Int                             @default(0) @map("daily_streak_day")
  // Consecutive-day login streak (unbounded) driving daily-box rarity odds.
  // Additive: dailyStreakDay keeps the legacy 6-day cycle for old app builds;
  // both claim paths maintain both counters.
  dailyLoginStreak                  Int                             @default(0) @map("daily_login_streak")
  isReviewAccount                   Boolean                         @default(false) @map("is_review_account")
  // Global-leaderboard opt-out. When true the user is hidden from OTHER users'
  // global step leaderboard (top list + rank count); they still appear to
  // friends and still see their own global rank. Additive/back-compat: defaults
  // false so existing rows and old clients (which ignore the field) are
  // unaffected. Mirrors isReviewAccount's column style.
  hiddenFromLeaderboard             Boolean                         @default(false) @map("hidden_from_leaderboard")
  // Auto-join the seeded daily/weekly featured challenges: the renewal cron
  // enrolls opted-in users into each newly created seeded race, and enabling
  // the toggle opts them into the already-pending next race. Additive/back-
  // compat: defaults false. See src/commands/autoJoinFeaturedRaces.js.
  autoJoinFeaturedRaces             Boolean                         @default(false) @map("auto_join_featured_races")
  // True once the user has either joined their first race via the onboarding
  // step or explicitly skipped it. Additive/back-compat: defaults false so
  // existing rows and old clients (which ignore the field) are unaffected.
  firstRaceOnboardingSeen           Boolean                         @default(false) @map("first_race_onboarding_seen")
  // True once the user has either completed or explicitly skipped the tutorial
  // step in onboarding. Gates only the onboarding step UI — the one-time 100-coin
  // tutorial reward is protected independently by the CoinTransaction ledger (see
  // awardCoins reason="tutorial_complete"). Additive/back-compat: defaults false;
  // a data migration backfills existing rows to true so they aren't re-onboarded.
  tutorialOnboardingSeen            Boolean                         @default(false) @map("tutorial_onboarding_seen")
  // Ranked: denormalized final tier from the most recently settled season, for
  // cheap cross-surface badges (races, leaderboard, profile). Additive/nullable
  // — null means unranked. Set by season settlement; never read by old clients.
  currentTier                       String?                         @map("current_tier")
  currentDivision                   Int?                            @map("current_division")
  // Ranked v2 (weekly cohorts): the user's persistent home tier on the 6-tier
  // ladder (BRONZE..LEGEND). Null = never placed (treated as BRONZE). Additive;
  // old clients never see this column — they keep reading currentTier, which v2
  // settlement writes with a legacy-mapped value (PLATINUM/LEGEND -> DIAMOND).
  rankedTierV2                      String?                         @map("ranked_tier_v2")
  rankedTierV2Since                 DateTime?                       @map("ranked_tier_v2_since")
  // ── Referral attribution (all nullable/additive) ─────────────────────────
  // This user's own shareable invite code (BARA-XXXX), minted lazily on first
  // /referrals/link call. The Referral table is the single source of truth for
  // who referred whom; referredByCode is audit-only and never the dedup key.
  // Old clients never read either column. See REFERRAL_FEATURE_RESEARCH.md §4A.
  referralCode                      String?                         @unique @map("referral_code")
  referredByCode                    String?                         @map("referred_by_code")
  // ── Team races: per-user client capabilities (TR-706) ─────────────────────
  // The union of every `X-Client-Features` token (e.g. ["team_races"]) ever
  // seen on one of this user's authenticated requests. STICKY: tokens are only
  // ever ADDED — a request that omits the header never clears them, so a stray
  // header-less call can't flicker the user to "needs app update" in friends'
  // pickers (TR-708) or block their invites (TR-707). Written only when a new
  // token appears (no hot write path). Empty array = never recorded any tokens
  // → INELIGIBLE for team races (pessimistic default covering accounts dormant
  // since before this deploy). clientFeaturesAt stamps the last write.
  // Additive/nullable — old app builds neither send nor read these; existing
  // rows default to an empty array.
  clientFeatures                    String[]                        @default([]) @map("client_features")
  clientFeaturesAt                  DateTime?                       @map("client_features_at")
  // ── Notification reminders (all additive) ─────────────────────────────────
  // The user's last-known IANA timezone, sticky-written from the request-scoped
  // X-Timezone header using the SAME never-on-every-request pattern as
  // clientFeatures/clientFeaturesAt (only written when it changed). Backfilled
  // null; the daily-reward reminder scheduler falls back to America/New_York for
  // a null timezone. First indexed column on this table (@@index below).
  timezone                          String?                         @map("timezone")
  globalEventTimezone               String?                         @map("global_event_timezone")
  globalEventTimezoneCandidate      String?                         @map("global_event_timezone_candidate")
  globalEventTimezoneCandidateSince DateTime?                       @map("global_event_timezone_candidate_since")
  // Opt-out for the evening daily-reward reminder pushes (§9.1). Absent/never-set
  // reads as true (the default). Old clients never call the preference endpoints
  // and keep the default. Additive/back-compat.
  dailyRewardRemindersEnabled       Boolean                         @default(true) @map("daily_reward_reminders_enabled")
  // Batch 2026-08-08 item 3: opt-out for the 19:00-local "you have uncollected
  // step-milestone coins" push. Same shape and same rationale as the daily-reward
  // pref above: absent/never-set reads as true, old clients never PATCH it and
  // keep the default. The job itself ships dark behind
  // STEP_MILESTONE_REMINDERS_DISABLED, so defaulting true sends nothing on its own.
  stepMilestoneRemindersEnabled     Boolean                         @default(true) @map("step_milestone_reminders_enabled")
  // Batch 2026-08-08 item 9: admin visibility into the app-version spread.
  // Sticky-written from X-App-Version in requireAuth, but ONLY when the version
  // changed or the stored lastSeenAt is on an earlier UTC day — never per
  // request (the 3e6c827 write-amplification lesson). Written through a
  // dedicated model method that deliberately skips the /auth/me cache DEL, and
  // NEITHER column is served in the /auth/me payload.
  lastAppVersion                    String?                         @map("last_app_version")
  lastSeenAt                        DateTime?                       @map("last_seen_at")
  metricsV2EligibleAt               DateTime?                       @map("metrics_v2_eligible_at")
  metricsV2EligibleEpochId          String?                         @map("metrics_v2_eligible_epoch_id")
  metricsV2SignupEligible           Boolean                         @default(false) @map("metrics_v2_signup_eligible")
  metricsV2SignupEpochId            String?                         @map("metrics_v2_signup_epoch_id")
  createdAt                         DateTime                        @default(now()) @map("created_at")
  steps                             Step[]
  dailyRewardClaims                 DailyRewardClaim[]
  stepMilestoneClaims               StepMilestoneClaim[]
  sentRequests                      Friendship[]                    @relation("sentRequests")
  receivedRequests                  Friendship[]                    @relation("receivedRequests")
  autoLinkSuppressionsAsA           FriendshipAutoLinkSuppression[] @relation("AutoLinkSuppressionA")
  autoLinkSuppressionsAsB           FriendshipAutoLinkSuppression[] @relation("AutoLinkSuppressionB")
  friendSearchRateWindow            FriendSearchRateWindow?
  fundedExposureGuard               FundedExposureGuard?

  challengesAsUserA  ChallengeInstance[] @relation("challengeUserA")
  challengesAsUserB  ChallengeInstance[] @relation("challengeUserB")
  challengesWon      ChallengeInstance[] @relation("challengeWinner")
  challengesProposed ChallengeInstance[] @relation("challengeProposer")
  deviceTokens       DeviceToken[]
  coinTransactions   CoinTransaction[]
  activationEvents   ActivationEvent[]
  activityDays       UserActivityDay[]
  pushDeliveries     PushDelivery[]

  racesCreated            Race[]                   @relation("raceCreator")
  racesWon                Race[]                   @relation("raceWinner")
  raceParticipations      RaceParticipant[]
  referralRaceActivities  ReferralRaceActivity[]   @relation("ReferralRaceActivityReferrer")
  raceMessages            RaceMessage[]
  stepSamples             StepSample[]
  shopItems               UserShopItem[]
  equippedAccessories     UserEquippedAccessory[]
  shopPurchaseRequests    ShopPurchaseRequest[]
  seasonScores            SeasonScore[]
  rankedCohortMemberships RankedCohortMember[]
  powerupItems            UserPowerupItem[]
  powerupPurchaseRequests PowerupPurchaseRequest[]
  notifications           Notification[]

  // Referral back-relations. Referral is the single source of truth for who→whom.
  referralsMade              Referral[]                  @relation("ReferralsMade")
  referralReceived           Referral?                   @relation("ReferralReceived")
  referralQualificationFacts ReferralQualificationFact[] @relation("ReferralQualificationFactReferrer")
  referralRewardGrants       ReferralRewardGrant[]
  adRewardGrants             AdRewardGrant[]
  interstitialAdCap          InterstitialAdCap?
  interstitialAdPermits      InterstitialAdPermit[]
  interstitialAdImpressions  InterstitialAdImpression[]
  racePayoutDoubleOffers     RacePayoutDoubleOffer[]

  // ── Tournaments (bracket mode) — all additive back-relations. Old app builds
  // never see these; existing rows are unaffected (no columns added to users).
  tournamentsCreated Tournament[]            @relation("TournamentCreator")
  tournamentsWon     Tournament[]            @relation("TournamentChampion")
  tournamentEntries  TournamentParticipant[]

  // ── Async step sync (Home/Races Refresh Performance) — additive back-relations.
  stepSyncRequests              StepSyncRequest[]
  raceResolutionJob             RaceResolutionJob?
  scoringInputVersion           UserScoringInputVersion?
  raceResolutionDeliveryIntents RaceResolutionDeliveryIntent[]

  // Batch 2026-08-08 item 7: in-app suggestion box. Cascade-deleted with the
  // account (see the FK on Suggestion) and explicitly listed in
  // deleteUserAccount's deletion set.
  suggestions                 Suggestion[]
  feedbackEmailAttempts       FeedbackEmailAttempt[]
  raceEffectImpacts           RaceEffectImpact[]
  raceImpactEvents            RaceImpactEvent[]
  umbrellaInterceptions       RaceUmbrellaInterception[]
  activeRaceImpactWork        ActiveRaceImpactWork[]
  activeRaceEffectImpacts     ActiveRaceEffectImpact[]
  globalEventRaceImpacts      GlobalEventRaceImpact[]
  globalEventUserSummaries    GlobalEventUserSummary[]
  globalEventSummaryWork      GlobalEventSummaryWork[]
  globalEventCaptureArtifacts GlobalEventCaptureArtifact[]
  globalStepEventEntitlements GlobalStepEventEntitlement[]
  appReviewPromptAttempts     AppReviewPromptAttempt[]
  inboxAlerts                 InboxAlert[]
  notificationSchedules       NotificationSchedule[]
  feedbackThreads             FeedbackThread[]
  raceShareLinksShared        RaceShareLink[]              @relation("RaceShareLinkSharer")
  raceJoinRequestsShared      RaceJoinRequest[]            @relation("RaceJoinRequestSharer")
  raceJoinRequestsRequested   RaceJoinRequest[]            @relation("RaceJoinRequestRequester")
  raceJoinRequestsCreated     RaceJoinRequest[]            @relation("RaceJoinRequestCreator")
  raceJoinRequestsResponded   RaceJoinRequest[]            @relation("RaceJoinRequestResponder")
  seededBucketAssignments     SeededRaceBucketAssignment[]
  seededRaceWindowMemberships SeededRaceWindowMembership[]
  giveawayEntrants            GiveawayEntrant[]

  // First index on this table. Backs the daily-reward reminder scheduler, which
  // selects users by IANA zone: findMany({ where: { timezone: { in: zonesAtSlot } } }).
  @@index([timezone])
  // Backs the admin version-spread report, which buckets users seen in the
  // last 30 days by lastAppVersion (batch 2026-08-08 item 9).
  @@index([lastSeenAt])
  @@map("users")
}

// Batch 2026-08-08 item 7: free-text product feedback submitted from Settings.
//
// PII stance: `text` is user free-writing. It is retained until the account is
// deleted, readable only through the admin-gated list endpoint, and
// cascade-deleted with the user. `onDelete: Cascade` is required — account
// deletion runs against a 5s transaction timeout and a blocking FK would make
// users with feedback undeletable.
model Suggestion {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  // Capped at 2000 chars by the endpoint, not the column.
  text       String
  category   String?
  // Provenance for triage, read from the X-App-Version / X-Platform headers.
  // Nullable: a client that sends neither still gets its suggestion stored.
  appVersion String?  @map("app_version")
  platform   String?
  createdAt  DateTime @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackThread FeedbackThread?

  // Backs the per-user per-UTC-day rate limit (5/day).
  @@index([userId, createdAt])
  // Backs the admin list (newest first, keyset-paged on createdAt).
  @@index([createdAt])
  @@map("suggestions")
}

enum FeedbackEmailAttemptState {
  RESERVED
  ACCEPTED
  FAILED
}

// Content-free delivery/quota metadata. Feedback text, category, reply address,
// and display name are deliberately never persisted here.
model FeedbackEmailAttempt {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id")
  utcDay        DateTime                  @map("utc_day")
  state         FeedbackEmailAttemptState @default(RESERVED)
  messageId     String                    @map("message_id")
  lastErrorCode String?                   @map("last_error_code")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @default(now()) @updatedAt @map("updated_at")
  expiresAt     DateTime                  @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, utcDay, state])
  @@index([expiresAt])
  @@map("feedback_email_attempts")
}

// Immutable, recipient-private components of a frozen race score. The effect
// ID is a stable canonical-artifact key rather than an FK: active-effect rows
// are lifecycle data and can be pruned after their settled explanation exists.
model RaceEffectImpact {
  id                 String    @id @default(uuid())
  raceId             String    @map("race_id")
  userId             String    @map("user_id")
  effectId           String    @map("effect_id")
  powerupType        String    @map("powerup_type")
  deltaSteps         Int       @map("delta_steps")
  attributionVersion Int       @default(1) @map("attribution_version")
  settledAt          DateTime  @default(now()) @map("settled_at")
  acknowledgedAt     DateTime? @map("acknowledged_at")

  race Race @relation(fields: [raceId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([raceId, userId, effectId])
  @@index([raceId, userId, acknowledgedAt, settledAt(sort: Desc)])
  @@index([userId, settledAt(sort: Desc)])
  @@map("race_effect_impacts")
}

// Immutable, recipient-private active-race score snapshots. The popup and the
// private Activity projection read this same row; acknowledging popup delivery
// never mutates or removes the Activity value.
model RaceImpactEvent {
  id                  String    @id @default(uuid())
  raceId              String    @map("race_id")
  recipientUserId     String    @map("recipient_user_id")
  sourceKind          String    @map("source_kind")
  sourceId            String    @map("source_id")
  sourceFeedEventId   String?   @map("source_feed_event_id")
  powerupType         String    @map("powerup_type")
  deltaSteps          Int       @map("delta_steps")
  description         String
  valueStatus         String    @default("SYNCED_SNAPSHOT") @map("value_status")
  calculationVersion  Int       @default(2) @map("calculation_version")
  resolvedAt          DateTime  @map("resolved_at")
  popupAcknowledgedAt DateTime? @map("popup_acknowledged_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  race            Race              @relation(fields: [raceId], references: [id], onDelete: Cascade)
  recipient       User              @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  sourceFeedEvent RacePowerupEvent? @relation(fields: [sourceFeedEventId], references: [id], onDelete: SetNull)

  @@unique([raceId, recipientUserId, sourceKind, sourceId, calculationVersion])
  @@index([raceId, recipientUserId, popupAcknowledgedAt, resolvedAt(sort: Desc), id(sort: Desc)])
  @@index([raceId, recipientUserId, resolvedAt(sort: Desc), id(sort: Desc)])
  @@map("race_impact_events")
}

// Durable domain source for an Umbrella interception. Unlike the retired v1
// hidden feed metadata, this row is indexed by its real resolution boundary.
model RaceUmbrellaInterception {
  id                 String    @id @default(uuid())
  raceId             String    @map("race_id")
  recipientUserId    String    @map("recipient_user_id")
  umbrellaEffectId   String    @map("umbrella_effect_id")
  rainstormPowerupId String    @map("rainstorm_powerup_id")
  windowStart        DateTime  @map("window_start")
  resolvesAt         DateTime  @map("resolves_at")
  avoidedMultiplier  Decimal   @map("avoided_multiplier") @db.Decimal(8, 6)
  status             String    @default("PENDING")
  resolvedAt         DateTime? @map("resolved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  race      Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([rainstormPowerupId, recipientUserId])
  @@index([raceId, status, resolvesAt, id])
  @@map("race_umbrella_interceptions")
}

// Durable, recipient-scoped work for active-race synced-step notifications.
// This is presentation/retry state only; final settlement continues to use
// RaceEffectImpact independently.
model ActiveRaceImpactWork {
  id                   String    @id @default(uuid())
  raceId               String    @map("race_id")
  recipientUserId      String    @map("recipient_user_id")
  sourceKind           String    @map("source_kind")
  sourceId             String    @map("source_id")
  powerupType          String    @map("powerup_type")
  status               String    @default("PENDING")
  resolvedAt           DateTime  @map("resolved_at")
  processedGeneration  Int?      @map("processed_generation")
  capturedDeltaSteps   Int?      @map("captured_delta_steps")
  calculationVersion   Int       @default(1) @map("calculation_version")
  inlineReceiptId      String?   @unique @map("inline_receipt_id")
  inlineAcknowledgedAt DateTime? @map("inline_acknowledged_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  race      Race                    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  recipient User                    @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  impact    ActiveRaceEffectImpact?

  @@unique([raceId, recipientUserId, sourceKind, sourceId, calculationVersion])
  @@index([raceId, status, resolvedAt, id])
  @@index([recipientUserId, status])
  @@map("active_race_impact_work")
}

// Immutable active-race presentation snapshots. A later whole-race settlement
// may differ after delayed device uploads; valueStatus keeps that distinction
// explicit on the wire.
model ActiveRaceEffectImpact {
  id                 String    @id @default(uuid())
  raceId             String    @map("race_id")
  userId             String    @map("user_id")
  workId             String    @unique @map("work_id")
  sourceKind         String    @map("source_kind")
  sourceId           String    @map("source_id")
  powerupType        String    @map("powerup_type")
  deltaSteps         Int       @map("delta_steps")
  valueStatus        String    @default("SYNCED_SNAPSHOT") @map("value_status")
  calculationVersion Int       @default(1) @map("calculation_version")
  sourceGeneration   Int?      @map("source_generation")
  resolvedAt         DateTime  @map("resolved_at")
  acknowledgedAt     DateTime? @map("acknowledged_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  race Race                 @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  work ActiveRaceImpactWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([raceId, userId, sourceKind, sourceId, calculationVersion])
  @@index([raceId, userId, acknowledgedAt, resolvedAt, id])
  @@index([userId, resolvedAt])
  @@map("active_race_effect_impacts")
}

model GlobalEventRaceImpact {
  id                           String    @id @default(uuid())
  eventId                      String    @map("event_id")
  raceId                       String    @map("race_id")
  userId                       String    @map("user_id")
  status                       String    @default("PENDING")
  deltaSteps                   Int?      @map("delta_steps")
  attributionVersion           Int       @default(1) @map("attribution_version")
  captureKind                  String?   @map("capture_kind")
  captureSyncRequestId         String?   @map("capture_sync_request_id")
  captureCompletedAt           DateTime? @map("capture_completed_at")
  captureCoverageThrough       DateTime? @map("capture_coverage_through")
  sourceScoringInputGeneration BigInt?   @map("source_scoring_input_generation")
  sourceResolutionGeneration   Int?      @map("source_resolution_generation")
  terminalReason               String?   @map("terminal_reason")
  terminalAt                   DateTime? @map("terminal_at")
  settledAt                    DateTime? @map("settled_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  event GlobalStepEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  race  Race            @relation(fields: [raceId], references: [id], onDelete: Restrict)
  user  User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, raceId, userId])
  @@index([eventId, userId, settledAt])
  @@index([userId, eventId])
  @@map("global_event_race_impacts")
}

model GlobalEventUserSummary {
  id                 String    @id @default(uuid())
  eventId            String    @map("event_id")
  userId             String    @map("user_id")
  extraRaceSteps     Int       @map("extra_race_steps")
  raceCount          Int       @map("race_count")
  attributionVersion Int       @default(1) @map("attribution_version")
  settledAt          DateTime  @default(now()) @map("settled_at")
  acknowledgedAt     DateTime? @map("acknowledged_at")
  expiresAt          DateTime? @map("expires_at")

  event GlobalStepEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId, acknowledgedAt, settledAt(sort: Desc)])
  @@index([userId, acknowledgedAt, expiresAt, settledAt(sort: Desc)])
  @@map("global_event_user_summaries")
}

model GlobalEventSummaryWork {
  id                           String    @id @default(uuid())
  eventId                      String    @map("event_id")
  userId                       String    @map("user_id")
  status                       String    @default("WAITING_SYNC")
  expiresAt                    DateTime  @map("expires_at")
  captureSyncRequestId         String?   @map("capture_sync_request_id")
  captureCompletedAt           DateTime? @map("capture_completed_at")
  captureCoverageThrough       DateTime? @map("capture_coverage_through")
  sourceScoringInputGeneration BigInt?   @map("source_scoring_input_generation")
  requiredRaceCount            Int       @default(0) @map("required_race_count")
  finalRaceCount               Int       @default(0) @map("final_race_count")
  raceReconciledAt             DateTime? @map("race_reconciled_at")
