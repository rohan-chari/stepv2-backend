// Privacy-bounded product activation telemetry. userId is always derived from
// the authenticated session (or a durable server-owned lifecycle write);
// context is validated/built from a small allowlist and never contains names,
// health/step data, or ad IDs. Opaque race IDs are allowed for funnel joins.
model ActivationEvent {
  id                  String   @id
  userId              String   @map("user_id")
  onboardingSessionId String?  @map("onboarding_session_id")
  name                String
  context             Json     @default("{}")
  appVersion          String   @map("app_version")
  platform            String
  occurredAt          DateTime @map("occurred_at")
  createdAt           DateTime @default(now()) @map("created_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([name, createdAt])
  @@index([appVersion, platform, createdAt])
  @@map("activation_events")
}

enum AccessorySlot {
  HEAD
  FACE
  NECK
  BACK
  FEET
  // Base body/character (e.g. the corgi). Never serialized into the
  // accessories/equippedAccessories arrays old clients render — character items
  // surface via the separate `animal` field and are hidden from the catalog
  // unless the client declares `characters` support, so old binaries never see
  // the unknown slot value and simply show the default capybara.
  CHARACTER
}

model ShopItem {
  id             String        @id @default(uuid())
  sku            String        @unique
  name           String
  description    String?
  slot           AccessorySlot
  priceCoins     Int           @map("price_coins")
  assetKey       String        @map("asset_key")
  renderMetadata Json?         @map("render_metadata")
  // Optional server-owned compatibility policy. Null/absent means this item
  // neither declares tags nor blocks another item. It is intentionally not in
  // public catalog serializers: clients do not get to enforce outfit rules.
  compatibility  Json?
  active         Boolean       @default(true)
  // When true, the item is hidden from prod-channel clients (only requests that
  // identify as a TestFlight build see it). Flip to false to launch it to ALL
  // app versions instantly — no app release needed. Default false = prod-visible,
  // so existing items and old app binaries are unaffected. NOT serialized into
  // the public catalog response (keeps the JSON shape byte-compatible).
  testOnly       Boolean       @default(false) @map("test_only")
  // When true, the item can never be bought or listed in the catalog — it is
  // granted directly (e.g. the Legend ranked cosmetic). Owners can still equip
  // it and it renders on all social surfaces. Server-side filter only, so the
  // catalog JSON shape is unchanged for old clients. Default false = every
  // existing item keeps working.
  earnOnly       Boolean       @default(false) @map("earn_only")
  // When true, the accessory rides the capybara's head-bob animation. Historically
  // this was derived purely from slot (HEAD/FACE/NECK bobbed, BACK/FEET did not),
  // so the migration backfills exactly that: existing HEAD/FACE/NECK items -> true,
  // everything else -> false. Now an admin can toggle it per-item (e.g. make the
  // BACK backpack bob). Serialized into the catalog; old app binaries simply ignore
  // the extra field and keep using their slot-based fallback, so they're unaffected.
  bobble         Boolean       @default(false)
  sortOrder      Int           @default(0) @map("sort_order")
  // CDN-served art. NULL (the default, and every pre-existing row) means the
  // PNG is bundled in the app binary — the historical path, unchanged. A
  // non-null 12-hex sha256 prefix means the art lives on the server at
  // /assets/<accessories|characters>/<assetKey>@<assetVersion>.png; the version
  // is the cache key, so the URL is immutable and safe to cache forever.
  // Additive + nullable: old deployed code and frozen app binaries never see it.
  assetVersion   String?       @map("asset_version")
  // A remote-only PNG has no bundled fallback in pre-CDN app binaries. Keep the
  // default false so an existing (or newly created) remote-backed item remains
  // visible to every client and can use its bundled fallback. Only true is
  // capability-gated to `remote_assets` clients.
  remoteOnly     Boolean       @default(false) @map("remote_only")
  createdAt      DateTime      @default(now()) @map("created_at")

  purchases        UserShopItem[]
  equipped         UserEquippedAccessory[]
  purchaseRequests ShopPurchaseRequest[]

  @@index([active, sortOrder])
  @@map("shop_items")
}

model UserShopItem {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  shopItemId  String   @map("shop_item_id")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@unique([userId, shopItemId])
  @@index([shopItemId])
  @@map("user_shop_items")
}

model UserEquippedAccessory {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  slot       AccessorySlot
  shopItemId String        @map("shop_item_id")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@unique([userId, slot])
  @@index([shopItemId])
  @@map("user_equipped_accessories")
}

model ShopPurchaseRequest {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  idempotencyKey String   @map("idempotency_key")
  shopItemId     String   @map("shop_item_id")
  status         String
  coinsSpent     Int      @default(0) @map("coins_spent")
  resultJson     Json?    @map("result_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([shopItemId])
  @@map("shop_purchase_requests")
}

// ── Powerup store (coin-purchasable powerups) ───────────────────────────────
// A SEPARATE catalog from the cosmetic ShopItem table so that the cosmetic
// catalog (GET /shop/catalog) stays byte-compatible for old app versions. Only
// the new app reads these tables via the new /shop/powerups endpoints.

// Catalog of coin-purchasable powerups (re-buyable, stack in global inventory).
// The SINGLE SOURCE OF TRUTH for user-facing powerup copy (§9.5), keyed by
// PowerupType rather than by SKU: only 6 of the usable types have a shop row, so
// PowerupShopItem could never cover the in-race surfaces. One row per
// user-renderable type; MYSTERY_BOX is intentionally excluded (it is an
// unopened-container inventory state, not a usable powerup with use-sheet or
// effect-rail copy).
//
// Served by GET /powerups/catalog and consumed by getPowerupShopCatalog, which
// keeps its own response SHAPE unchanged for old clients while sourcing `name`
// and `description` from here.
model PowerupCopy {
  powerupType       PowerupType @id @map("powerup_type")
  name              String
  description       String
  // NULLABLE on purpose: only 15 of the 26 pre-existing types have short-form
  // effect-rail copy today. When it is null the client omits the subtitle line
  // entirely rather than substituting a truncated description.
  shortDescription  String?     @map("short_description")
  // 4 entries for upgradeable types ("Extend 1h", "Extend 1.5h", ...), empty
  // otherwise. Tier labels encode durations and drift for the same reason the
  // Leech copy did, so they are data-driven like the upgrade COSTS already are.
  upgradeTierLabels String[]    @map("upgrade_tier_labels")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("powerup_copy")
}

model PowerupShopItem {
  id                  String      @id @default(uuid())
  sku                 String      @unique
  // DEPRECATED as a source of copy (§9.5.2): retained for additive-schema
  // compatibility and still RETURNED by GET /shop/powerups, but the served
  // strings now come from PowerupCopy. Do not edit these columns to change copy.
  name                String
  description         String?
  priceCoins          Int         @map("price_coins")
  powerupType         PowerupType @map("powerup_type")
  active              Boolean     @default(true)
  // See ShopItem.testOnly — same prod/TestFlight gate for the powerup catalog.
  testOnly            Boolean     @default(false) @map("test_only")
  dailyRewardEligible Boolean     @default(true) @map("daily_reward_eligible")
  sortOrder           Int         @default(0) @map("sort_order")
  // See ShopItem.assetVersion. NULL => the icon is bundled in the app binary
  // (PowerupIcon's compiled-in asset map). Non-null => served from
  // /assets/powerups/<powerup_type lowercased>@<assetVersion>.png.
  assetVersion        String?     @map("asset_version")
  createdAt           DateTime    @default(now()) @map("created_at")

  @@index([active, sortOrder])
  @@map("powerup_shop_items")
}

// A user's GLOBAL powerup inventory: how many of each powerup type they own,
// spendable into any active race they're in. One row per (user, type).
model UserPowerupItem {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  powerupType PowerupType @map("powerup_type")
  quantity    Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, powerupType])
  @@index([userId])
  @@map("user_powerup_items")
}

// Idempotency ledger for powerup-store purchases — analogous to
// ShopPurchaseRequest but for the powerup catalog (keeps the cosmetic ledger
// untouched). Keyed on (userId, idempotencyKey).
model PowerupPurchaseRequest {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  idempotencyKey    String   @map("idempotency_key")
  powerupShopItemId String   @map("powerup_shop_item_id")
  status            String
  coinsSpent        Int      @default(0) @map("coins_spent")
  resultJson        Json?    @map("result_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([powerupShopItemId])
  @@map("powerup_purchase_requests")
}

enum PowerupType {
  LEG_CRAMP         @map("leg_cramp")
  RED_CARD          @map("red_card")
  SHORTCUT          @map("shortcut")
  COMPRESSION_SOCKS @map("compression_socks")
  PROTEIN_SHAKE     @map("protein_shake")
  RUNNERS_HIGH      @map("runners_high")
  SECOND_WIND       @map("second_wind")
  STEALTH_MODE      @map("stealth_mode")
  WRONG_TURN        @map("wrong_turn")
  FANNY_PACK        @map("fanny_pack")
  TRAIL_MIX         @map("trail_mix")
  DETOUR_SIGN       @map("detour_sign")
  LUCKY_HORSESHOE   @map("lucky_horseshoe")
  CAMPFIRE_REST     @map("campfire_rest")
  TRAIL_MAGNET      @map("trail_magnet")
  POCKET_WATCH      @map("pocket_watch")
  TRAIL_MINE        @map("trail_mine")
  PINECONE_TOSS     @map("pinecone_toss")
  SNEAKY_SWAP       @map("sneaky_swap")
  MIRROR            @map("mirror")
  CLEANSE           @map("cleanse")
  // IMPOSTER is PURCHASE-ONLY (from the coin store). It is intentionally NOT in
  // any mystery-box rarity tier, so it can never roll from a box. Additive enum
  // value; placed before mystery_box to match the schema's declared ordering.
  IMPOSTER          @map("imposter")
  // RAINSTORM is PURCHASE-ONLY (coin store, like IMPOSTER) and never rolls from
  // a mystery box. Untargeted AoE: halves every OTHER participant's steps for
  // 1 hour. Additive enum value, placed before mystery_box to match ordering.
  RAINSTORM         @map("rainstorm")
  // SIGNAL_JAMMER is STORE-ONLY (coin store, like IMPOSTER / RAINSTORM) and
  // never rolls from a mystery box. Targeted single-target attack: the target
  // cannot USE any powerup in the race for 1 hour. Additive enum value, placed
  // before mystery_box to match the schema's declared ordering.
  SIGNAL_JAMMER     @map("signal_jammer")
  // LEECH is STORE-ONLY (coin store, like IMPOSTER / RAINSTORM / SIGNAL_JAMMER)
  // and never rolls from a mystery box. Targeted, leecher-driven debuff: for 30
  // minutes every step the leecher takes removes one step from the chosen rival
  // (capped at 3000, max 2 leechers per victim). Blocked by Compression Socks,
  // never reflected by a Mirror. Additive enum value, placed before mystery_box.
  LEECH             @map("leech")
  // DEFENSE_SCAN (shipped as "X-Ray") is STORE-ONLY and instantaneous — it grants
  // no timed effect. Using it returns a snapshot of every opponent's active
  // defenses (Compression Socks / Mirror) in the use response. Additive enum
  // value, placed before mystery_box to match the schema's declared ordering.
  DEFENSE_SCAN      @map("defense_scan")
  // HITCHHIKE is STORE-ONLY and never rolls from a mystery box or daily reward
  // box. Targeted, TARGET-driven copy: for 60 minutes the caster COPIES the
  // target's recorded raw steps 1:1 into their own score — the target loses
  // nothing. One active link per caster AND one per target. Compression Socks
  // block it; a Mirror never reflects it. Copied steps do NOT advance mystery-box
  // progress (the term is added at the scoring assembly, never to baseAdjusted).
  // Additive enum value, placed BEFORE mystery_box to match the declared ordering.
  HITCHHIKE         @map("hitchhike")
  // QUICK_RINSE is STORE-ONLY, SELF-ONLY and instantaneous: it HALVES the
  // remaining duration of every active timed opponent-inflicted effect on the
  // user. It creates no effect of its own. Additive enum value, placed BEFORE
  // mystery_box to match the declared ordering.
  QUICK_RINSE       @map("quick_rinse")
  // Store-only multi-target freeze, visible only to powerups4 clients.
  QUICKSAND         @map("quicksand")
  // Powerups Wave 5 (store-only, visible only to `powerups5` clients). All 11
  // are additive enum values placed BEFORE mystery_box to match the schema's
  // declared ordering. See docs/powerups5-wave-requirements.md.
  UPRISING          @map("uprising")
  GHOST_PEPPER      @map("ghost_pepper")
  COIN_FLIP         @map("coin_flip")
  MYSTERY_POTION    @map("mystery_potion")
  DECOY             @map("decoy")
  POWER_OUTAGE      @map("power_outage")
  UMBRELLA          @map("umbrella")
  RALLY_FLAG        @map("rally_flag")
  DRILL_SERGEANT    @map("drill_sergeant")
  PIGGY_BANK        @map("piggy_bank")
  BOUNTY            @map("bounty")
  MYSTERY_BOX       @map("mystery_box")
}

enum PowerupRarity {
  COMMON   @map("common")
  UNCOMMON @map("uncommon")
  RARE     @map("rare")
}

enum PowerupStatus {
  MYSTERY_BOX @map("mystery_box")
  QUEUED      @map("queued")
  HELD        @map("held")
  USED        @map("used")
  DISCARDED   @map("discarded")
  EXPIRED     @map("expired")
}

enum ActiveEffectStatus {
  ACTIVE  @map("active_effect")
  EXPIRED @map("expired_effect")
  BLOCKED @map("blocked")
}

enum RaceStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

enum RaceParticipantStatus {
  INVITED  @map("invited")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
}

enum RacePayoutPreset {
  WINNER_TAKES_ALL @map("winner_takes_all")
  TOP3_70_20_10    @map("top3_70_20_10")
  TOP3_80_15_5     @map("top3_80_15_5")
  // Field-scaled presets (added later): the number of paid places grows with the
  // field. Only emitted by newer app builds; older clients keep sending the
  // three above. See src/utils/racePayoutPresets.js.
  TOP_HALF         @map("top_half")
  ALL_BUT_LAST     @map("all_but_last")
}

enum RaceBuyInStatus {
  NONE      @map("none")
  HELD      @map("held")
  COMMITTED @map("committed")
  REFUNDED  @map("refunded")
}

// Team-race sides (TR-900 Team Race Mode). A team race has exactly two teams;
// every ACCEPTED participant belongs to one. Null on individual races and on
// pre-team-era rows. Additive enum — old app builds never see the column.
enum RaceTeam {
  TEAM_A @map("team_a")
  TEAM_B @map("team_b")
}

enum SeededRaceBucketStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum SeededRaceBucketAssignmentState {
  ELECTED
  ASSIGNED
  PRUNED
  FINAL
}

enum SeededRaceWindowStream {
  LEGACY
  BUCKET
}

// Immutable placement policy for one seeded Daily/Weekly window. This is
// deliberately distinct from the live feature flag: a window is stamped once
// at creation, so a rollback can affect only later windows.
enum SeededRaceWindowMode {
  LEGACY
  BUCKET
}

// One lock row per user serializes funded-membership admission across races
// and tournaments. Exposure totals remain derived from stamped participant
// rows; this table deliberately stores no mutable balance/counter.
model FundedExposureGuard {
  userId    String   @id @map("user_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("funded_exposure_guards")
}

model Race {
  id                            String           @id @default(uuid())
  creatorId                     String?          @map("creator_id")
  seedId                        String?          @map("seed_id")
  name                          String
  targetSteps                   Int              @map("target_steps")
  status                        RaceStatus       @default(PENDING)
  // maxDurationDays is set on all new races; kept nullable for backward compat
  // with existing rows from the step-goal-only window which have NULL.
  maxDurationDays               Int?             @map("max_duration_days")
  buyInAmount                   Int              @default(0) @map("buy_in_amount")
  payoutPreset                  RacePayoutPreset @default(WINNER_TAKES_ALL) @map("payout_preset")
  potCoins                      Int              @default(0) @map("pot_coins")
  // ── App-funded prize pools ─────────────────────────────────────────────────
  // fundedPrize is the discriminator between the two money models and the ONLY
  // authority at settlement (never the fundedPrizePoolsEnabled flag, so a
  // mid-race flip can't strand a promised prize). true => nobody was charged to
  // enter and the app MINTS players × durationPoints(days) × PRIZE_COIN_UNIT at
  // settlement. false (the default, and every pre-existing row) => the legacy
  // buy-in pot model: HELD/COMMITTED coins pay out or refund exactly as before.
  // The two are mutually exclusive, so no competition can ever pay under both.
  // prizePoolCoins stamps the SETTLED pool so a completed race's numbers can
  // never drift when the accepted/eligible count changes afterwards.
  // Additive with safe legacy defaults — no backfill, and old app builds never
  // read either column.
  fundedPrize                   Boolean          @default(false) @map("funded_prize")
  prizePoolCoins                Int              @default(0) @map("prize_pool_coins")
  prizeCoinUnit                 Int?             @map("prize_coin_unit")
  prizePoolMaxCoins             Int?             @map("prize_pool_max_coins")
  prizeCalculationVersion       Int              @default(1) @map("prize_calculation_version")
  // Immutable at creation: 0 preserves the historical payout formula, 1 rounds
  // every final positive recipient award up to a multiple of five.
  payoutRoundingVersion         Int              @default(0) @map("payout_rounding_version")
  payoutRoundingMetadata        Json?            @map("payout_rounding_metadata")
  // Default-off, creation-stamped exit policy. Existing races remain false so
  // enabling the rollout setting never changes an already-open competition.
  exitActionsEnabled            Boolean          @default(false) @map("exit_actions_enabled")
  // How a FUNDED race splits its pool across the paid places of a graded preset
  // (TOP_HALF / ALL_BUT_LAST). Stamped at creation and never rewritten, exactly
  // like fundedPrize: the row is the authority, never the live flag, so an
  // in-flight race can never have its advertised payout table change shape
  // underneath it. NULL (every pre-existing row, and every user-created race)
  // = the even split shipped today; "GEOMETRIC" = the top-heavy 0.7 decay.
  // Only createSeededRace ever writes it. Not serialized to clients.
  payoutCurve                   String?          @map("payout_curve")
  // Next-race quick-create provenance. Both are nullable so every existing
  // race and every frozen client remains on the legacy/manual-start path.
  // Prisma does not model the predicate-specific indexes added by the raw
  // migration; that schema drift is intentional and those indexes must remain.
  creationSource                String?          @map("creation_source")
  startPolicy                   String?          @map("start_policy")
  // Batch 2026-08-08 item 5: team-race prize-pool multiplier, in basis points,
  // STAMPED AT CREATION from the TEAM_POOL_MULT_* envs and read by BOTH the
  // live projection and settlement so the two can never disagree.
  // NULL = 1.0x = today's formula, which is what every pre-existing race keeps.
  // Because it is stamped, an env edit only affects races created after it —
  // an in-flight race never reprices mid-race.
  teamPoolMultBps               Int?             @map("team_pool_mult_bps")
  // Fixed per-eligible-winner funded-team payout stamp. Both fields must be a
  // valid V1 pair before readers/settlement use them; NULL, partial, or malformed
  // pairs stay on the legacy divisible-pool formula. Nullable so Deployment A
  // can coexist with old workers and every existing race remains unchanged.
  teamPayoutVersion             Int?             @map("team_payout_version")
  teamWinnerRewardCoins         Int?             @map("team_winner_reward_coins")
  startedAt                     DateTime?        @map("started_at")
  endsAt                        DateTime?        @map("ends_at")
  // Optional future auto-start time (1.1.7). When set and in the future, the
  // race stays PENDING and the autoStartScheduledRaces cron job starts it once
  // this time passes; manual start is blocked until then. Nullable/additive:
  // legacy races and older app clients (which never send it) behave exactly as
  // before — manual instant start.
  scheduledStartAt              DateTime?        @map("scheduled_start_at")
  // Optional EXACT end instant chosen by the creator (custom race window). Inert
  // until startRace promotes it: it is NOT `endsAt`, because `endsAt` on a
  // non-COMPLETED race is read everywhere as "this live race's end" (featured
  // lists, next-race home, powerup guards, placement recompute). Stamping that
  // on a PENDING race would change the field's meaning for every one of those
  // readers. At start, resolveRaceEndsAt copies it into `endsAt` when at least
  // MIN_RACE_WINDOW_MS of the window is left; otherwise the race falls back to
  // maxDurationDays from the actual start and this column stays as a record of
  // intent. Nullable/additive with NO backfill: every existing row stays NULL
  // and behaves byte-for-byte as today, and frozen clients never send or read it.
  scheduledEndAt                DateTime?        @map("scheduled_end_at")
  // Canonical IANA timezone whose calendar-day boundaries define this race's
  // step buckets (e.g. "America/New_York" for seeded daily/weekly challenges).
  // NULL for user-created races, which keep the legacy behavior: live display
  // buckets in the requester's tz, settlement in UTC. When set, BOTH live and
  // settlement bucket in this tz, so "midnight" means the same instant for every
  // participant and live totals match settled totals. Nullable/additive: old app
  // clients never read it; old rows stay NULL and behave exactly as before.
  timezone                      String?          @map("timezone")
  completedAt                   DateTime?        @map("completed_at")
  winnerUserId                  String?          @map("winner_user_id")
  powerupsEnabled               Boolean          @default(false) @map("powerups_enabled")
  powerupStepInterval           Int?             @map("powerup_step_interval")
  isPublic                      Boolean          @default(false) @map("is_public")
  // Nullable: NULL means "no participant limit" (unlimited). Older app clients
  // always send an integer, and the @default(10) keeps legacy creates that omit
  // the field unchanged. Additive/backward-compatible — relaxing NOT NULL only.
  maxParticipants               Int?             @default(10) @map("max_participants")
  // When true, the race never finishes on reaching targetSteps; targetSteps is
  // a display-only goal and the winner is decided by step count when ends_at
  // passes (raceExpiry.js). Additive/backward-compatible: defaults false so
  // legacy target races created by older app versions keep finishing on target.
  timeBased                     Boolean          @default(false) @map("time_based")
  // Opaque, unguessable token backing shareable race links (https://<host>/r/
  // <token>). Nullable: minted lazily the first time a participant shares the
  // race, so legacy races stay NULL until shared. Additive/backward-compatible —
  // older app clients never read or send it. Unique so a token resolves to at
  // most one race; @unique also creates the lookup index used by findByShareToken.
  shareToken                    String?          @unique @map("share_token")
  // ── Team races (TR-100/§12) ────────────────────────────────────────────────
  // isTeamRace flips a race into two-team mode: exactly two sides, team size
  // 1–5, combined team totals, winnerTeam decides. teamSize is the per-side cap
  // (maxParticipants = 2 × teamSize). teamAName/teamBName are the two playful
  // side names (auto-generated at creation, creator-overridable). winnerTeam is
  // the settled result (TEAM_A|TEAM_B|null); winnerUserId stays null for team
  // races. All additive/nullable — old app builds never send or read them, and a
  // race with isTeamRace=false renders exactly as an individual race.
  isTeamRace                    Boolean          @default(false) @map("is_team_race")
  teamSize                      Int?             @map("team_size")
  teamAName                     String?          @map("team_a_name")
  teamBName                     String?          @map("team_b_name")
  winnerTeam                    RaceTeam?        @map("winner_team")
  // ── Tournaments (bracket mode) ──────────────────────────────────────────────
  // A matchup race is an ordinary time-based WINNER_TAKES_ALL race that belongs
  // to one tournament round. tournamentId != null flags it as a matchup: it is
  // filtered out of every existing race listing for ALL clients and is managed
  // only by the tournament engine (every race-level mutation returns
  // TOURNAMENT_RACE_LOCKED). tournamentRound is 1-based; tournamentMatchIndex is
  // 0-based within the round. The @@unique makes double-advancement a hard DB
  // error (advancement idempotency backstop). All additive/nullable — old app
  // builds never send or read them and old rows stay NULL.
  tournamentId                  String?          @map("tournament_id")
  tournamentRound               Int?             @map("tournament_round")
  tournamentMatchIndex          Int?             @map("tournament_match_index")
  // Durable identity for the one prospective mid-match tournament powerup
  // activation. Nullable for every legacy/non-matchup race. The C0 worker
  // compares this stamp before touching participant baselines on a replay.
  tournamentPowerupsActivatedAt DateTime?        @map("tournament_powerups_activated_at") @db.Timestamptz(3)
  // A private Daily/Weekly bucket's immutable identity. Nullable and unique so
  // all historical/global seeded races continue on the legacy stream.
  seededBucketId                String?          @unique @map("seeded_bucket_id")
  createdAt                     DateTime         @default(now()) @map("created_at")
  updatedAt                     DateTime         @updatedAt @map("updated_at")

  creator                      User?                         @relation("raceCreator", fields: [creatorId], references: [id])
  seed                         RaceSeed?                     @relation(fields: [seedId], references: [id])
  winner                       User?                         @relation("raceWinner", fields: [winnerUserId], references: [id])
  tournament                   Tournament?                   @relation(fields: [tournamentId], references: [id])
  participants                 RaceParticipant[]
  powerups                     RacePowerup[]
  activeEffects                RaceActiveEffect[]
  powerupEvents                RacePowerupEvent[]
  messages                     RaceMessage[]
  payoutDoubleOfferItems       RacePayoutDoubleOfferItem[]
  resolutionJob                RaceResolutionJobV2?
  placementTransitionJob       RacePlacementTransitionJob?
  resolutionPostTasks          RaceResolutionPostTask[]
  shareLinks                   RaceShareLink[]
  joinRequests                 RaceJoinRequest[]
  adminCommands                RaceAdminCommand[]
  seededBucket                 SeededRaceBucket?             @relation("SeededBucketRace")
  effectImpacts                RaceEffectImpact[]
  impactEvents                 RaceImpactEvent[]
  umbrellaInterceptions        RaceUmbrellaInterception[]
  activeImpactWork             ActiveRaceImpactWork[]
  activeEffectImpacts          ActiveRaceEffectImpact[]
  globalEventImpacts           GlobalEventRaceImpact[]
  globalEventCaptureArtifacts  GlobalEventCaptureArtifact[]
  reviewPromptAttempts         AppReviewPromptAttempt[]
  referralQualifications       Referral[]                    @relation("ReferralQualifyingRace")
  referralQualificationIntents ReferralQualificationIntent[] @relation("ReferralQualificationIntentRace")

  @@unique([tournamentId, tournamentRound, tournamentMatchIndex])
  @@index([creatorId])
  @@index([status])
  @@index([winnerUserId])
  @@index([isPublic, status])
  @@index([seedId, status])
  @@index([tournamentId, status])
  @@map("races")
}

enum RaceSeedCadence {
  DAILY  @map("daily")
  WEEKLY @map("weekly")
}

model RaceSeed {
  id                  String          @id
  kind                String          @unique
  name                String
  targetSteps         Int             @map("target_steps")
  // durationHours is read for new seeded races to compute endsAt; kept
  // nullable in the schema for backward compat with existing rows.
  durationHours       Int?            @map("duration_hours")
  cadence             RaceSeedCadence
  maxParticipants     Int             @default(100) @map("max_participants")
  // Per-seed powerup config applied to each seeded race created from this seed.
  powerupsEnabled     Boolean         @default(false) @map("powerups_enabled")
  powerupStepInterval Int?            @map("powerup_step_interval")
  // Seeded races created from this seed inherit this flag. Defaults false for
  // backward compat; set true on DAILY_10K/WEEKLY_50K to make them time-based.
  timeBased           Boolean         @default(false) @map("time_based")
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  races                   Race[]
  seededBuckets           SeededRaceBucket[]
  seededWindowMemberships SeededRaceWindowMembership[]
  seededWindowModes       SeededRaceWindowModeRecord[]

  @@map("race_seeds")
}

// ── Tournaments (single-elimination bracket mode) ─────────────────────────────
// A Tournament is a bracket of 1v1 winner-take-all step matchups (4/8/16
// players). Each matchup is an ordinary Race (see Race.tournamentId); the
// Tournament layer owns seeding, round advancement, and the coin pot. All new
// tables/columns are additive — old app builds never touch them.
enum TournamentStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

model Tournament {
  id                         String           @id @default(uuid())
  // null = seeded/featured (system-minted), mirrors Race.creatorId.
  creatorId                  String?          @map("creator_id")
  // Links to the TournamentSeed for featured brackets; null for user-created.
  seedId                     String?          @map("seed_id")
  name                       String
  status                     TournamentStatus @default(PENDING)
  bracketSize                Int              @map("bracket_size") // 4 | 8 | 16
  matchupDurationDays        Int              @map("matchup_duration_days") // 1 | 2 | 3
  // 0 (free), or 10..TOURNAMENT_BUYIN_MAX[bracketSize] = 100/100/62 (D4 ladder).
  buyInAmount                Int              @default(0) @map("buy_in_amount")
  potCoins                   Int              @default(0) @map("pot_coins")
  // App-funded bracket pool (same semantics as Race.fundedPrize/prizePoolCoins).
  // Entry is free; the champion is paid a MINTED pool of
  // acceptedPlayers × durationPoints(totalRounds × matchupDurationDays) ×
  // PRIZE_COIN_UNIT, clamped to MAX_CHAMPION_PRIZE. Mutually exclusive with both
  // the legacy pot payout and a featured seed's championPrizeCoins.
  fundedPrize                Boolean          @default(false) @map("funded_prize")
  prizePoolCoins             Int              @default(0) @map("prize_pool_coins")
  prizeCoinUnit              Int?             @map("prize_coin_unit")
  tournamentChampionMaxCoins Int?             @map("tournament_champion_max_coins")
  prizeCalculationVersion    Int              @default(1) @map("prize_calculation_version")
  payoutRoundingVersion      Int              @default(0) @map("payout_rounding_version")
  payoutRoundingMetadata     Json?            @map("payout_rounding_metadata")
  powerupsEnabled            Boolean          @default(false) @map("powerups_enabled")
  powerupStepInterval        Int?             @map("powerup_step_interval")
  isPublic                   Boolean          @default(false) @map("is_public")
  shareToken                 String?          @unique @map("share_token")
  // Creator's IANA zone at creation; "America/New_York" for seeded. Matchup
  // races inherit it as their canonical scoring tz.
  timezone                   String?          @map("timezone")
  currentRound               Int              @default(0) @map("current_round") // 0 = not started
  totalRounds                Int              @map("total_rounds") // log2(bracketSize)
  championUserId             String?          @map("champion_user_id")
  // Featured-seed prize quoted when the lobby is minted. Nullable so legacy
  // rows keep their historical seed lookup until they settle.
  championPrizeCoinsSnapshot Int?             @map("champion_prize_coins_snapshot")
  createdAt                  DateTime         @default(now()) @map("created_at")
  startedAt                  DateTime?        @map("started_at")
  completedAt                DateTime?        @map("completed_at")

  creator      User?                   @relation("TournamentCreator", fields: [creatorId], references: [id])
  champion     User?                   @relation("TournamentChampion", fields: [championUserId], references: [id])
  seed         TournamentSeed?         @relation(fields: [seedId], references: [id])
  participants TournamentParticipant[]
  races        Race[]

  @@index([isPublic, status])
  @@index([creatorId, status])
  @@index([seedId, status])
  @@map("tournaments")
}

model TournamentSeed {
  id                  String   @id // stable key, e.g. "seed-tournament-daily-dash"
  kind                String   @unique @map("kind") // e.g. "DAILY_DASH"
  name                String // copied verbatim to each minted tournament
  bracketSize         Int      @map("bracket_size")
  matchupDurationDays Int      @map("matchup_duration_days")
  powerupsEnabled     Boolean  @default(false) @map("powerups_enabled")
  powerupStepInterval Int?     @map("powerup_step_interval")
  championPrizeCoins  Int      @map("champion_prize_coins") // minted prize (featured are always free); <= 1000
  active              Boolean  @default(true) // reconciler only reconciles active seeds
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tournaments Tournament[]

  @@map("tournament_seeds")
}

model TournamentParticipant {
  id                                 String                @id @default(uuid())
  tournamentId                       String                @map("tournament_id")
  userId                             String                @map("user_id")
  // Reuse the race participant status enum (INVITED/ACCEPTED/DECLINED).
  status                             RaceParticipantStatus @default(INVITED)
  seed                               Int? // bracket slot 0..bracketSize-1, assigned at start
  eliminatedInRound                  Int?                  @map("eliminated_in_round") // null = still alive (or champion)
  buyInAmount                        Int                   @default(0) @map("buy_in_amount")
  // Reuse the race buy-in status enum (NONE/HELD/COMMITTED/REFUNDED).
  buyInStatus                        RaceBuyInStatus       @default(NONE) @map("buy_in_status")
  // Increments on every refund; suffixes ledger refIds so a re-hold after
  // leave->rejoin can never silently no-op against an old ledger row (§7).
  buyInVersion                       Int                   @default(0) @map("buy_in_version")
  // Monotonic occurrence identity for a declined invitation that is sent
  // again on the same participant row. The durable event key uses this value
  // so each legitimate invite remains immutable and retry-safe.
  inviteVersion                      Int                   @default(0) @map("invite_version")
  // ACCEPT time (updated on re-accept); the D3 exact-tie tiebreak key.
  joinedAt                           DateTime              @default(now()) @map("joined_at")
  fundedExposureMillicoins           Int?                  @map("funded_exposure_millicoins")
  fundedExposureRateMillicoinsPerDay Int?                  @map("funded_exposure_rate_millicoins_per_day")
  createdAt                          DateTime              @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([userId, status])
  @@map("tournament_participants")
}

model RaceParticipant {
  id                                 String                @id @default(uuid())
  raceId                             String                @map("race_id")
  userId                             String                @map("user_id")
  status                             RaceParticipantStatus @default(INVITED)
  totalSteps                         Int                   @default(0) @map("total_steps")
  // When `totalSteps` was last persisted (batch 2026-07-26, item 16). GET /races
  // keeps serving the cheap PERSISTED team totals — no live recompute on the
  // hottest screen — and now surfaces max(totalsUpdatedAt) as `teams.asOf` so the
  // client can render "as of N min ago" instead of a silently stale number.
  // Additive/nullable: NULL simply means "never written since this deploy", and
  // the client hides the staleness affordance. Written in the same UPDATE that
  // writes totalSteps, so it costs no extra round-trip.
  totalsUpdatedAt                    DateTime?             @map("totals_updated_at")
  // RAW WALKED steps (`baseAdjusted`) as of the last persist — the same
  // manipulation-proof quantity box progress uses: no buffs, no debuffs, no
  // bonus steps, so it only ever grows by walking. Written by every writer of
  // `totalSteps` (legacy replay persist, the v2 worker's fenced replay, and the
  // step-upload reconcile). Frozen (finished/forfeited) rows keep their last
  // persisted value.
  //
  // MONOTONIC PER WRITER, with a bounded race window — NOT a strict
  // never-decreases guarantee. Each writer high-waters the value it writes
  // (`max(existing, baseAdjusted)`), which is what stops a downward re-sync of
  // step_samples from walking a player's odds position backwards. But the
  // worker reads `existing` OUTSIDE its write transaction, so a concurrent
  // reconcile write that lands in between can be clobbered by up to one sync
  // interval's worth of steps. Accepted: it is the same last-writer-wins shape
  // `total_steps` itself already has, and the worst case is odds computed from
  // a slightly stale raw total that the next persist repairs.
  //
  // Read ONLY as the mystery-box drop-odds position (openMysteryBox,
  // rerollMysteryBox, getRaceProgress's dropOdds) via the shared
  // `rawPositionFor` helper. NULL = never persisted since the deploy; if ANY
  // accepted participant of a race is NULL the whole race falls back to
  // `totalSteps`. Additive/nullable, no index (never a query predicate), and
  // never returned by any API — old app versions are unaffected.
  rawSteps                           Int?                  @map("raw_steps")
  baselineSteps                      Int                   @default(0) @map("baseline_steps")
  nextBoxAtSteps                     Int                   @default(0) @map("next_box_at_steps")
  bonusSteps                         Int                   @default(0) @map("bonus_steps")
  maxBonusSteps                      Int                   @default(0) @map("max_bonus_steps")
  // DEPRECATED / UNUSED. Was a box-progress high-water anchor meant to make box
  // progress immune to Leg Cramp/Wrong Turn, but it froze the countdown while a
  // player sat below their pre-debuff peak. Product decision: box progress is
  // debuff-sensitive (the bonusSteps high-water still protects bonus-steal). No
  // code reads this column anymore; it is retained (not dropped) to avoid a
  // destructive migration. Safe to remove in a future schema-cleanup release.
  maxBoxProgressSteps                Int?                  @map("max_box_progress_steps")
  powerupSlots                       Int                   @default(3) @map("powerup_slots")
  buyInAmount                        Int                   @default(0) @map("buy_in_amount")
  buyInStatus                        RaceBuyInStatus       @default(NONE) @map("buy_in_status")
  // Monotonic per-participant edit counter (Issue 4). Bumped each time the owner
  // reconciles the buy-in on a PENDING race; the versioned value forms a unique
  // coin-ledger refId (`<raceId>:<userId>:v<n>`) so a re-charge after a refund is
  // never silently skipped by awardCoins idempotency. Additive, default 0 — old
  // rows and old app versions are unaffected (nothing reads it client-side).
  buyInVersion                       Int                   @default(0) @map("buy_in_version")
  payoutCoins                        Int                   @default(0) @map("payout_coins")
  placement                          Int?
  // Live placement broadcast (Phase 0): last live rank we pushed to this
  // participant, for idempotent change detection in placementRecompute. NULL =
  // baseline not yet seeded. Additive + nullable; never returned by any API
  // response, so already-shipped app versions are unaffected.
  lastNotifiedPlacement              Int?                  @map("last_notified_placement")
  // High-multiplier alert dedup (item 6b): the moment we last emitted a
  // HIGH_MULTIPLIER_ALERT because this participant's current (stacked,
  // event-inclusive) multiplier crossed above the threshold. Set on emit,
  // CLEARED when the multiplier drops back to <= threshold so the alert re-arms
  // for the next spike. Additive + nullable; never returned by any API response,
  // so already-shipped app versions are unaffected.
  highMultiplierNotifiedAt           DateTime?             @map("high_multiplier_notified_at")
  finishedAt                         DateTime?             @map("finished_at")
  finishTotalSteps                   Int?                  @map("finish_total_steps")
  joinedAt                           DateTime              @default(now()) @map("joined_at")
  lastReadRaceChatAt                 DateTime?             @map("last_read_race_chat_at")
  lastChatPushAt                     DateTime?             @map("last_chat_push_at")
  chatMuted                          Boolean               @default(false) @map("chat_muted")
  // Per-race opt-out for live placement-change pushes (Phase 0). When true, the
  // placementRecompute job keeps this participant's lastNotifiedPlacement baseline
  // in sync but emits no PLACEMENT_CHANGED event, so they get neither the visible
  // alert nor the silent refresh for this race. Additive + default-false: old app
  // versions never set it and behave exactly as before.
  placementAlertsMuted               Boolean               @default(false) @map("placement_alerts_muted")
  // Daily biggest-mover digest: this participant's live rank captured at the last
  // 4pm-ET digest run, the baseline the next run measures movement against (a
  // rolling 24h window). NULL = not yet seeded; the digest job lazily seeds it and
  // emits nothing for that first partial window. Reset to the current live rank on
  // every run. Additive + nullable; never returned by any API, so already-shipped
  // app versions are unaffected.
  dayStartPlacement                  Int?                  @map("day_start_placement")
  inviteExpiresAt                    DateTime?             @map("invite_expires_at")
  resultsSeenAt                      DateTime?             @map("results_seen_at")
  // Team-race side (TR-201). Null on individual races and on pre-team-era rows.
  // Set at join/accept for team races; freely switchable while PENDING, locked
  // at start. Additive/nullable — old app builds never read it.
  team                               RaceTeam?
  // Mid-race forfeit moment (TR-601, team races only). When set, the member's
  // effective total is FROZEN as-is into totalSteps (active debuffs bite
  // permanently — no re-derivation), they stop accruing, can't use or be
  // targeted by powerups, and get no payout cut even on the winning team.
  // Null = never forfeited. Additive/nullable — old app builds never read it.
  forfeitedAt                        DateTime?             @map("forfeited_at")
  fundedExposureMillicoins           Int?                  @map("funded_exposure_millicoins")
  fundedExposureRateMillicoinsPerDay Int?                  @map("funded_exposure_rate_millicoins_per_day")

  race                   Race                        @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user                   User                        @relation(fields: [userId], references: [id])
  powerups               RacePowerup[]
  activeEffectsReceived  RaceActiveEffect[]
  payoutDoubleOfferItem  RacePayoutDoubleOfferItem?
  seededBucketAssignment SeededRaceBucketAssignment?
  referralRaceActivity   ReferralRaceActivity?

  @@unique([raceId, userId])
  @@index([userId, status])
  @@index([raceId, status])
  @@index([userId, status, inviteExpiresAt])
  @@map("race_participants")
}

model SeededRaceBucket {
  id          String                 @id @default(uuid())
  seedId      String                 @map("seed_id")
  windowStart DateTime               @map("window_start") @db.Timestamptz(3)
  windowEnd   DateTime               @map("window_end") @db.Timestamptz(3)
  raceId      String                 @unique @map("race_id")
  status      SeededRaceBucketStatus @default(PENDING)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  seed        RaceSeed                     @relation(fields: [seedId], references: [id])
  race        Race                         @relation("SeededBucketRace", fields: [raceId], references: [id])
  assignments SeededRaceBucketAssignment[]

  @@unique([seedId, windowStart, id])
  @@index([seedId, windowStart, status, createdAt])
  @@map("seeded_race_buckets")
}

model SeededRaceBucketAssignment {
  bucketId          String                          @map("bucket_id")
  userId            String                          @map("user_id")
  seedId            String                          @map("seed_id")
  windowStart       DateTime                        @map("window_start") @db.Timestamptz(3)
  raceParticipantId String                          @unique @map("race_participant_id")
  matchSteps        Int                             @default(0) @map("match_steps")
  assignedAt        DateTime                        @default(now()) @map("assigned_at")
  state             SeededRaceBucketAssignmentState @default(ASSIGNED)

  bucket          SeededRaceBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  raceParticipant RaceParticipant  @relation(fields: [raceParticipantId], references: [id])

  @@id([bucketId, userId])
  @@unique([seedId, windowStart, userId])
  @@map("seeded_race_bucket_assignments")
}

model SeededRaceWindowMembership {
  id          String                 @id @default(uuid())
  seedId      String                 @map("seed_id")
  windowStart DateTime               @map("window_start") @db.Timestamptz(3)
  userId      String                 @map("user_id")
  stream      SeededRaceWindowStream
  raceId      String?                @map("race_id")
  createdAt   DateTime               @default(now()) @map("created_at")

  seed RaceSeed @relation(fields: [seedId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([seedId, windowStart, userId])
  @@index([seedId, windowStart, stream])
  @@map("seeded_race_window_memberships")
}

model SeededRaceWindowModeRecord {
  seedId      String               @map("seed_id")
  windowStart DateTime             @map("window_start") @db.Timestamptz(3)
  mode        SeededRaceWindowMode
  windowEnd   DateTime             @map("window_end") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  seed RaceSeed @relation(fields: [seedId], references: [id])

  @@id([seedId, windowStart])
  @@index([windowStart, mode])
  @@map("seeded_race_window_modes")
}

// One immutable, server-prepared rewarded-ad batch. These tables are additive
// and dark by default; frozen clients neither create nor read them.
model RacePayoutDoubleOffer {
  id                             String    @id @default(uuid())
  userId                         String    @map("user_id")
  baseCoins                      Int       @map("base_coins")
  bonusCoins                     Int       @map("bonus_coins")
  maxBonusCoins                  Int       @map("max_bonus_coins")
  rolling24hRemainingBeforeClaim Int       @map("rolling_24h_remaining_before_claim")
  providerSubHash                String    @map("provider_sub_hash")
  // Additive mode discriminator. Rows created before flat-50 was deployed
  // default to the legacy payout-doubling semantics and retain their stored
  // amount through retry and claim.
  rewardMode                     String    @default("legacy_double") @map("reward_mode")
  status                         String    @default("PENDING")
  claimedAt                      DateTime? @map("claimed_at")
  forfeitedAt                    DateTime? @map("forfeited_at")
  createdAt                      DateTime  @default(now()) @map("created_at")

  user  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items RacePayoutDoubleOfferItem[]

  @@index([userId, status, createdAt])
  @@index([status, claimedAt])
  @@map("race_payout_double_offers")
}

model RacePayoutDoubleOfferItem {
  id                String  @id @default(uuid())
  offerId           String  @map("offer_id")
  raceParticipantId String? @unique @map("race_participant_id")
  raceId            String? @map("race_id")
  raceIdSnapshot    String  @map("race_id_snapshot")
  placementSnapshot Int?    @map("placement_snapshot")
  eligibleCoins     Int     @map("eligible_coins")
  sourceReason      String  @map("source_reason")
  sourceRefId       String  @map("source_ref_id")

  offer           RacePayoutDoubleOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  raceParticipant RaceParticipant?      @relation(fields: [raceParticipantId], references: [id], onDelete: SetNull)
  race            Race?                 @relation(fields: [raceId], references: [id], onDelete: SetNull)

  @@unique([offerId, raceIdSnapshot])
  @@map("race_payout_double_offer_items")
}

// Provider-neutral durable identity and rolling records deliberately do not
// reference User, so delete/recreate cannot reset cohort or 24h allowance.
model RacePayoutDoubleIdentity {
  providerSubHash String   @id @map("provider_sub_hash")
  cohortBucket    Int      @map("cohort_bucket")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("race_payout_double_identities")
}

model RacePayoutDoubleVelocityGrant {
  id              String   @id @default(uuid())
  providerSubHash String   @map("provider_sub_hash")
  offerId         String   @unique @map("offer_id")
  bonusCoins      Int      @map("bonus_coins")
  claimedAt       DateTime @default(now()) @map("claimed_at")

  @@index([providerSubHash, claimedAt])
  @@index([claimedAt])
  @@map("race_payout_double_velocity_grants")
}

model RacePayoutDoubleClaimReceipt {
  offerId          String    @id @map("offer_id")
  providerSubHash  String    @map("provider_sub_hash")
  bonusCoins       Int       @map("bonus_coins")
  claimedAt        DateTime  @map("claimed_at")
  accountDeletedAt DateTime? @map("account_deleted_at")

  @@index([claimedAt])
  @@map("race_payout_double_claim_receipts")
}

model RacePowerup {
  id                    String         @id @default(uuid())
  raceId                String         @map("race_id")
  participantId         String         @map("participant_id")
  userId                String         @map("user_id")
  type                  PowerupType?
  rarity                PowerupRarity?
  status                PowerupStatus  @default(HELD)
  earnedAtSteps         Int?           @map("earned_at_steps")
  // Exact provenance for the temporary race row created when an account-wide
  // inventory item is redeemed. Default false keeps old writers and legacy
  // rows fail-closed: they can remain HELD, but can never mint an inventory
  // refund without an explicit redemption stamp.
  redeemedFromInventory Boolean        @default(false) @map("redeemed_from_inventory")
  usedAt                DateTime?      @map("used_at")
  targetUserId          String?        @map("target_user_id")
  upgradeLevel          Int            @default(0) @map("upgrade_level")
  // Balance-config version that produced this roll (D9 provenance). Nullable and
  // additive: rows created before balance config shipped stay NULL, and a roll
  // that happens while the config table is unreadable (code-defaults fallback)
  // also stays NULL. Stamped only where rarity is actually decided —
  // openMysteryBox / openMysteryBoxBatch — never in rollPowerup, which mints
  // unopened MYSTERY_BOX rows and rolls nothing.
  configVersion         Int?           @map("config_version")
  // Batch 2026-08-08 item 11: when this rolled powerup was rerolled via a
  // rewarded ad. NULL = never rerolled (true of every pre-existing row), which
  // is what the once-per-roll guard tests. Additive/nullable.
  rerolledAt            DateTime?      @map("rerolled_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  race          Race               @relation(fields: [raceId], references: [id], onDelete: Cascade)
  participant   RaceParticipant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  activeEffects RaceActiveEffect[]

  @@unique([participantId, earnedAtSteps])
  @@index([participantId, status])
  @@index([raceId, userId])
  @@index([userId, status, raceId])
  @@map("race_powerups")
}

