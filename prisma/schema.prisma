// Receipts are independent of contest existence so an idempotency key keeps
// its meaning across create, archive, and retention. The unique actor/key pair
// deliberately spans every giveaway admin mutation.
model GiveawayIdempotencyReceipt {
  id             String   @id @default(uuid())
  actorId        String   @map("actor_id")
  idempotencyKey String   @map("idempotency_key")
  method         String
  contestId      String?  @map("contest_id")
  requestHash    String   @map("request_hash")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([actorId, idempotencyKey])
  @@index([createdAt])
  @@map("giveaway_idempotency_receipts")
}

model GiveawayResult {
