  rawSourceKind           String    @map("raw_source_kind") @db.VarChar(32)
  rawSourceHighWater      Int       @default(0) @map("raw_source_high_water")
  coarseSourceFrom        Int?      @map("coarse_source_from")
  coarseSourceThrough     Int?      @map("coarse_source_through")
  coarseRawAttributed     Int       @default(0) @map("coarse_raw_attributed")
  coarseEffectiveContribution Int   @default(0) @map("coarse_effective_contribution")
