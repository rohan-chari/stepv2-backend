  revision            Int                   @default(1)
  governingTimeZone   String                @map("governing_time_zone")
  startsAt            DateTime              @map("starts_at")
  endsAt              DateTime              @map("ends_at")
  cashCurrency        String                @default("USD") @map("cash_currency")
  cashMinor           Int                   @default(5000) @map("cash_minor")
  coinPrize           Int                   @default(5000) @map("coin_prize")
  eligibilityMode     String                @default("US_18") @map("eligibility_mode")
  minimumAge          Int?                  @map("minimum_age")
  eligibleCountries   Json?                 @map("eligible_countries")
  eligibleRegions     Json?                 @map("eligible_regions")
  sponsor             Json
  rulesVersion        String                @map("rules_version")
  rulesSections       Json                  @map("rules_sections")
  rulesHash           String                @map("rules_hash")
  socialLinks         Json                  @default("[]") @map("social_links")
  bannerMessage       String                @map("banner_message")
