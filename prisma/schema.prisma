generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String               @id @default(uuid())
  // Auth identity is single-provider per user: Apple (iOS) OR Google (Android).
  // Both are nullable+unique so a pure-Google user has no appleId and vice versa.
  // Postgres unique indexes allow multiple NULLs, so many users can share a null
  // on either column. Existing Apple rows are untouched. See ANDROID.md §G1.
  appleId                       String?              @unique @map("apple_id")
  googleSub                     String?              @unique @map("google_sub")
  email                         String?
  name                          String?
  displayName                   String?              @unique @map("display_name")
  profilePhotoUrl               String?              @map("profile_photo_url")
  profilePhotoKey               String?              @map("profile_photo_key")
  profilePhotoPromptDismissedAt DateTime?            @map("profile_photo_prompt_dismissed_at")
  // Home SETUP section: how many times the "you can rename yourself" chip has
  // been shown to this ACCOUNT, and when the user retired it. Previously lived
  // in device-scoped SharedPreferences, which signOut() wipes — so the chip came
  // back on every sign-out/sign-in cycle. Additive/back-compat: NOT NULL DEFAULT
  // 0 and nullable timestamp, so old clients (which never read or write these)
  // are unaffected, and no backfill is performed (every existing row starts
  // eligible). See docs/home-setup-section-requirements.md §5.
  renameChipShownCount          Int                  @default(0) @map("rename_chip_shown_count")
  renameChipDismissedAt         DateTime?            @map("rename_chip_dismissed_at")
  // Deprecated: step goals are no longer part of the product. Kept
  // nullable for back-compat with existing rows. New code must not read
  // or write this field.
  stepGoal                      Int?                 @map("step_goal")
  lastStepSyncAt                DateTime?            @map("last_step_sync_at")
  lastSilentPushSentAt          DateTime?            @map("last_silent_push_sent_at")
  coins                         Int                  @default(0)
  lastDailyClaimDate            String?              @map("last_daily_claim_date")
  dailyStreakDay                Int                  @default(0) @map("daily_streak_day")
  // Consecutive-day login streak (unbounded) driving daily-box rarity odds.
  // Additive: dailyStreakDay keeps the legacy 6-day cycle for old app builds;
  // both claim paths maintain both counters.
  dailyLoginStreak              Int                  @default(0) @map("daily_login_streak")
  isReviewAccount               Boolean              @default(false) @map("is_review_account")
  // Global-leaderboard opt-out. When true the user is hidden from OTHER users'
  // global step leaderboard (top list + rank count); they still appear to
  // friends and still see their own global rank. Additive/back-compat: defaults
  // false so existing rows and old clients (which ignore the field) are
  // unaffected. Mirrors isReviewAccount's column style.
  hiddenFromLeaderboard         Boolean              @default(false) @map("hidden_from_leaderboard")
  // Auto-join the seeded daily/weekly featured challenges: the renewal cron
  // enrolls opted-in users into each newly created seeded race, and enabling
  // the toggle opts them into the already-pending next race. Additive/back-
  // compat: defaults false. See src/commands/autoJoinFeaturedRaces.js.
  autoJoinFeaturedRaces         Boolean              @default(false) @map("auto_join_featured_races")
  // True once the user has either joined their first race via the onboarding
  // step or explicitly skipped it. Additive/back-compat: defaults false so
  // existing rows and old clients (which ignore the field) are unaffected.
  firstRaceOnboardingSeen       Boolean              @default(false) @map("first_race_onboarding_seen")
  // True once the user has either completed or explicitly skipped the tutorial
  // step in onboarding. Gates only the onboarding step UI — the one-time 100-coin
  // tutorial reward is protected independently by the CoinTransaction ledger (see
  // awardCoins reason="tutorial_complete"). Additive/back-compat: defaults false;
  // a data migration backfills existing rows to true so they aren't re-onboarded.
  tutorialOnboardingSeen        Boolean              @default(false) @map("tutorial_onboarding_seen")
  // Ranked: denormalized final tier from the most recently settled season, for
  // cheap cross-surface badges (races, leaderboard, profile). Additive/nullable
  // — null means unranked. Set by season settlement; never read by old clients.
  currentTier                   String?              @map("current_tier")
  currentDivision               Int?                 @map("current_division")
  // Ranked v2 (weekly cohorts): the user's persistent home tier on the 6-tier
  // ladder (BRONZE..LEGEND). Null = never placed (treated as BRONZE). Additive;
  // old clients never see this column — they keep reading currentTier, which v2
  // settlement writes with a legacy-mapped value (PLATINUM/LEGEND -> DIAMOND).
  rankedTierV2                  String?              @map("ranked_tier_v2")
  rankedTierV2Since             DateTime?            @map("ranked_tier_v2_since")
  // ── Referral attribution (all nullable/additive) ─────────────────────────
  // This user's own shareable invite code (BARA-XXXX), minted lazily on first
  // /referrals/link call. The Referral table is the single source of truth for
  // who referred whom; referredByCode is audit-only and never the dedup key.
  // Old clients never read either column. See REFERRAL_FEATURE_RESEARCH.md §4A.
  referralCode                  String?              @unique @map("referral_code")
  referredByCode                String?              @map("referred_by_code")
  // ── Team races: per-user client capabilities (TR-706) ─────────────────────
  // The union of every `X-Client-Features` token (e.g. ["team_races"]) ever
  // seen on one of this user's authenticated requests. STICKY: tokens are only
  // ever ADDED — a request that omits the header never clears them, so a stray
  // header-less call can't flicker the user to "needs app update" in friends'
  // pickers (TR-708) or block their invites (TR-707). Written only when a new
  // token appears (no hot write path). Empty array = never recorded any tokens
  // → INELIGIBLE for team races (pessimistic default covering accounts dormant
  // since before this deploy). clientFeaturesAt stamps the last write.
  // Additive/nullable — old app builds neither send nor read these; existing
  // rows default to an empty array.
  clientFeatures                String[]             @default([]) @map("client_features")
  clientFeaturesAt              DateTime?            @map("client_features_at")
  // ── Notification reminders (all additive) ─────────────────────────────────
  // The user's last-known IANA timezone, sticky-written from the request-scoped
  // X-Timezone header using the SAME never-on-every-request pattern as
  // clientFeatures/clientFeaturesAt (only written when it changed). Backfilled
  // null; the daily-reward reminder scheduler falls back to America/New_York for
  // a null timezone. First indexed column on this table (@@index below).
  timezone                      String?              @map("timezone")
  // Opt-out for the evening daily-reward reminder pushes (§9.1). Absent/never-set
  // reads as true (the default). Old clients never call the preference endpoints
  // and keep the default. Additive/back-compat.
  dailyRewardRemindersEnabled   Boolean              @default(true) @map("daily_reward_reminders_enabled")
  // Batch 2026-08-08 item 3: opt-out for the 19:00-local "you have uncollected
  // step-milestone coins" push. Same shape and same rationale as the daily-reward
  // pref above: absent/never-set reads as true, old clients never PATCH it and
  // keep the default. The job itself ships dark behind
  // STEP_MILESTONE_REMINDERS_DISABLED, so defaulting true sends nothing on its own.
  stepMilestoneRemindersEnabled Boolean              @default(true) @map("step_milestone_reminders_enabled")
  // Batch 2026-08-08 item 9: admin visibility into the app-version spread.
  // Sticky-written from X-App-Version in requireAuth, but ONLY when the version
  // changed or the stored lastSeenAt is on an earlier UTC day — never per
  // request (the 3e6c827 write-amplification lesson). Written through a
  // dedicated model method that deliberately skips the /auth/me cache DEL, and
  // NEITHER column is served in the /auth/me payload.
  lastAppVersion                String?              @map("last_app_version")
  lastSeenAt                    DateTime?            @map("last_seen_at")
  createdAt                     DateTime             @default(now()) @map("created_at")
  steps                         Step[]
  dailyRewardClaims             DailyRewardClaim[]
  stepMilestoneClaims           StepMilestoneClaim[]
  sentRequests                  Friendship[]         @relation("sentRequests")
  receivedRequests              Friendship[]         @relation("receivedRequests")

  challengesAsUserA  ChallengeInstance[] @relation("challengeUserA")
  challengesAsUserB  ChallengeInstance[] @relation("challengeUserB")
  challengesWon      ChallengeInstance[] @relation("challengeWinner")
  challengesProposed ChallengeInstance[] @relation("challengeProposer")
  deviceTokens       DeviceToken[]
  coinTransactions   CoinTransaction[]
  activationEvents   ActivationEvent[]

  racesCreated            Race[]                   @relation("raceCreator")
  racesWon                Race[]                   @relation("raceWinner")
  raceParticipations      RaceParticipant[]
  raceMessages            RaceMessage[]
  stepSamples             StepSample[]
  shopItems               UserShopItem[]
  equippedAccessories     UserEquippedAccessory[]
  shopPurchaseRequests    ShopPurchaseRequest[]
  seasonScores            SeasonScore[]
  rankedCohortMemberships RankedCohortMember[]
  powerupItems            UserPowerupItem[]
  powerupPurchaseRequests PowerupPurchaseRequest[]
  notifications           Notification[]

  // Referral back-relations. Referral is the single source of truth for who→whom.
  referralsMade        Referral[]            @relation("ReferralsMade")
  referralReceived     Referral?             @relation("ReferralReceived")
  referralRewardGrants ReferralRewardGrant[]
  adRewardGrants       AdRewardGrant[]

  // ── Tournaments (bracket mode) — all additive back-relations. Old app builds
  // never see these; existing rows are unaffected (no columns added to users).
  tournamentsCreated Tournament[]            @relation("TournamentCreator")
  tournamentsWon     Tournament[]            @relation("TournamentChampion")
  tournamentEntries  TournamentParticipant[]

  // ── Async step sync (Home/Races Refresh Performance) — additive back-relations.
  stepSyncRequests  StepSyncRequest[]
  raceResolutionJob RaceResolutionJob?

  // Batch 2026-08-08 item 7: in-app suggestion box. Cascade-deleted with the
  // account (see the FK on Suggestion) and explicitly listed in
  // deleteUserAccount's deletion set.
  suggestions Suggestion[]

  // First index on this table. Backs the daily-reward reminder scheduler, which
  // selects users by IANA zone: findMany({ where: { timezone: { in: zonesAtSlot } } }).
  @@index([timezone])
  // Backs the admin version-spread report, which buckets users seen in the
  // last 30 days by lastAppVersion (batch 2026-08-08 item 9).
  @@index([lastSeenAt])
  @@map("users")
}

// Batch 2026-08-08 item 7: free-text product feedback submitted from Settings.
//
// PII stance: `text` is user free-writing. It is retained until the account is
// deleted, readable only through the admin-gated list endpoint, and
// cascade-deleted with the user. `onDelete: Cascade` is required — account
// deletion runs against a 5s transaction timeout and a blocking FK would make
// users with feedback undeletable.
model Suggestion {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  // Capped at 2000 chars by the endpoint, not the column.
  text       String
  category   String?
  // Provenance for triage, read from the X-App-Version / X-Platform headers.
  // Nullable: a client that sends neither still gets its suggestion stored.
  appVersion String?  @map("app_version")
  platform   String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Backs the per-user per-UTC-day rate limit (5/day).
  @@index([userId, createdAt])
  // Backs the admin list (newest first, keyset-paged on createdAt).
  @@index([createdAt])
  @@map("suggestions")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum RelationshipType {
  PARTNER @map("partner")
  FRIEND  @map("friend")
  FAMILY  @map("family")
}

model StepMilestoneClaim {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  claimedDate String   @map("claimed_date")
  threshold   Int
  coins       Int
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, claimedDate, threshold])
  @@index([userId, claimedDate])
  @@map("step_milestone_claims")
}

model DailyRewardClaim {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  claimedDate String   @map("claimed_date")
  cycleDay    Int      @map("cycle_day")
  rewardType  String   @map("reward_type")
  // Rarity of the daily-box roll (COMMON/UNCOMMON/RARE). Null for legacy
  // ladder claims from old app builds.
  rarity      String?
  coinAmount  Int?     @map("coin_amount")
  shopItemId  String?  @map("shop_item_id")
  // Powerup type won when rewardType = POWERUP (daily-box shop-powerup prize).
  // Null for every other reward type and for legacy claims. Plain string (not
  // the PowerupType enum) to match rarity/shopItemId — this is an audit column.
  powerupType String?  @map("powerup_type")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, claimedDate])
  @@index([userId, createdAt])
  @@map("daily_reward_claims")
}

// Verified rewarded-ad watches (AdMob server-side verification). One row per
// SSV callback, idempotent on transactionId — the row is minted by Google's
// signed callback, never by the client, so it's the trust anchor for ad
// rewards. consumedAt is set when the reward is redeemed (extra daily box
// spin); the roll's result is denormalized onto the row instead of creating a
// second DailyRewardClaim, whose @@unique([userId, claimedDate]) is
// load-bearing for the free daily spin. See AD_REWARD_DESIGN.md (frontend repo).
model AdRewardGrant {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  adUnit        String?   @map("ad_unit")
  transactionId String    @unique @map("transaction_id")
  rewardKind    String    @default("extra_daily_spin") @map("reward_kind")
  // User-local YYYY-MM-DD the ad was watched (SSV custom_data; server UTC
  // date fallback). The extra-spin claim consumes a grant for its localDate.
  grantedDate   String    @map("granted_date")
  consumedAt    DateTime? @map("consumed_at")
  // Roll result, written at consumption (mirrors DailyRewardClaim columns).
  rewardType    String?   @map("reward_type")
  rarity        String?
  coinAmount    Int?      @map("coin_amount")
  shopItemId    String?   @map("shop_item_id")
  // Powerup type won when rewardType = POWERUP (extra-spin shop-powerup prize).
  powerupType   String?   @map("powerup_type")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, grantedDate])
  @@map("ad_reward_grants")
}

model Friendship {
  id               String            @id @default(uuid())
  requesterId      String            @map("requester_id")
  addresseeId      String            @map("addressee_id")
  status           FriendshipStatus  @default(PENDING)
  relationshipType RelationshipType? @map("relationship_type")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  requester        User              @relation("sentRequests", fields: [requesterId], references: [id])
  addressee        User              @relation("receivedRequests", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model Step {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  steps     Int
  stepGoal  Int?     @map("step_goal")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
  @@map("steps")
}

model StepSample {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  steps           Int
  sourceName      String?  @map("source_name")
  sourceId        String?  @map("source_id")
  sourceDeviceId  String?  @map("source_device_id")
  deviceModel     String?  @map("device_model")
  recordingMethod String?  @map("recording_method")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodStart])
  @@index([userId, periodStart, periodEnd])
  @@map("step_samples")
}

enum ChallengeType {
  HEAD_TO_HEAD @map("head_to_head")
  THRESHOLD    @map("threshold")
  CREATIVE     @map("creative")
}

model Challenge {
  id               String              @id @default(uuid())
  title            String
  description      String
  type             ChallengeType
  resolutionRule   String              @map("resolution_rule")
  thresholdValue   Int?                @map("threshold_value")
  active           Boolean             @default(true)
  lastUsedAt       DateTime?           @map("last_used_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  instances        ChallengeInstance[]
  weeklyChallenges WeeklyChallenge[]

  @@map("challenges")
}

model WeeklyChallenge {
  id          String    @id @default(uuid())
  weekOf      DateTime  @unique @map("week_of") @db.Date
  challengeId String    @map("challenge_id")
  droppedAt   DateTime  @default(now()) @map("dropped_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([challengeId])
  @@map("weekly_challenges")
}

enum StakeStatus {
  PROPOSING @map("proposing")
  AGREED    @map("agreed")
  SKIPPED   @map("skipped")
}

enum ChallengeInstanceStatus {
  PENDING_STAKE @map("pending_stake")
  ACTIVE        @map("active")
  COMPLETED     @map("completed")
}

model ChallengeInstance {
  id              String                  @id @default(uuid())
  challengeId     String                  @map("challenge_id")
  weekOf          DateTime                @map("week_of") @db.Date
  userAId         String                  @map("user_a_id")
  userBId         String                  @map("user_b_id")
  stakeId         String?                 @map("stake_id")
  stakeStatus     StakeStatus             @default(PROPOSING) @map("stake_status")
  proposedById    String?                 @map("proposed_by_id")
  proposedStakeId String?                 @map("proposed_stake_id")
  status          ChallengeInstanceStatus @default(PENDING_STAKE)
  winnerUserId    String?                 @map("winner_user_id")
  userATotalSteps Int                     @default(0) @map("user_a_total_steps")
  userBTotalSteps Int                     @default(0) @map("user_b_total_steps")
  resolvedAt      DateTime?               @map("resolved_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  challenge     Challenge @relation(fields: [challengeId], references: [id])
  userA         User      @relation("challengeUserA", fields: [userAId], references: [id])
  userB         User      @relation("challengeUserB", fields: [userBId], references: [id])
  stake         Stake?    @relation("agreedStake", fields: [stakeId], references: [id])
  proposedStake Stake?    @relation("proposedStake", fields: [proposedStakeId], references: [id])
  winner        User?     @relation("challengeWinner", fields: [winnerUserId], references: [id])
  proposedBy    User?     @relation("challengeProposer", fields: [proposedById], references: [id])

  @@unique([userAId, userBId, weekOf])
  @@index([userAId, status])
  @@index([userBId, status])
  @@index([weekOf])
  @@map("challenge_instances")
}

enum StakeFormat {
  IN_PERSON @map("in_person")
  VIRTUAL   @map("virtual")
  EITHER    @map("either")
}

model Stake {
  id               String      @id @default(uuid())
  name             String
  description      String?
  category         String
  relationshipTags String[]    @map("relationship_tags")
  format           StakeFormat
  sponsorId        String?     @map("sponsor_id")
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")

  agreedInstances   ChallengeInstance[] @relation("agreedStake")
  proposedInstances ChallengeInstance[] @relation("proposedStake")

  @@map("stakes")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

model CoinTransaction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reason, refId])
  @@index([userId])
  // Batch 2026-08-08 item 1: the powerup-discard daily coin cap sums this
  // user's `powerup_discard` rows for one local calendar day on every discard.
  // With only @@index([userId]) that sum scans a heavy user's whole ledger.
  @@index([userId, reason, createdAt])
  @@map("coin_transactions")
}

// Privacy-bounded product activation telemetry. userId is always derived from
// the authenticated session; context is validated against a small allowlist at
// ingestion and never contains names, race IDs, health/step data, or ad IDs.
model ActivationEvent {
  id                  String   @id
  userId              String   @map("user_id")
  onboardingSessionId String?  @map("onboarding_session_id")
  name                String
  context             Json     @default("{}")
  appVersion          String   @map("app_version")
  platform            String
  occurredAt          DateTime @map("occurred_at")
  createdAt           DateTime @default(now()) @map("created_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([name, createdAt])
  @@index([appVersion, platform, createdAt])
  @@map("activation_events")
}

enum AccessorySlot {
  HEAD
  FACE
  NECK
  BACK
  FEET
  // Base body/character (e.g. the corgi). Never serialized into the
  // accessories/equippedAccessories arrays old clients render — character items
  // surface via the separate `animal` field and are hidden from the catalog
  // unless the client declares `characters` support, so old binaries never see
  // the unknown slot value and simply show the default capybara.
  CHARACTER
}

model ShopItem {
  id             String        @id @default(uuid())
  sku            String        @unique
  name           String
  description    String?
  slot           AccessorySlot
  priceCoins     Int           @map("price_coins")
  assetKey       String        @map("asset_key")
  renderMetadata Json?         @map("render_metadata")
  active         Boolean       @default(true)
  // When true, the item is hidden from prod-channel clients (only requests that
  // identify as a TestFlight build see it). Flip to false to launch it to ALL
  // app versions instantly — no app release needed. Default false = prod-visible,
  // so existing items and old app binaries are unaffected. NOT serialized into
  // the public catalog response (keeps the JSON shape byte-compatible).
  testOnly       Boolean       @default(false) @map("test_only")
  // When true, the item can never be bought or listed in the catalog — it is
  // granted directly (e.g. the Legend ranked cosmetic). Owners can still equip
  // it and it renders on all social surfaces. Server-side filter only, so the
  // catalog JSON shape is unchanged for old clients. Default false = every
  // existing item keeps working.
  earnOnly       Boolean       @default(false) @map("earn_only")
  // When true, the accessory rides the capybara's head-bob animation. Historically
  // this was derived purely from slot (HEAD/FACE/NECK bobbed, BACK/FEET did not),
  // so the migration backfills exactly that: existing HEAD/FACE/NECK items -> true,
  // everything else -> false. Now an admin can toggle it per-item (e.g. make the
  // BACK backpack bob). Serialized into the catalog; old app binaries simply ignore
  // the extra field and keep using their slot-based fallback, so they're unaffected.
  bobble         Boolean       @default(false)
  sortOrder      Int           @default(0) @map("sort_order")
  // CDN-served art. NULL (the default, and every pre-existing row) means the
  // PNG is bundled in the app binary — the historical path, unchanged. A
  // non-null 12-hex sha256 prefix means the art lives on the server at
  // /assets/<accessories|characters>/<assetKey>@<assetVersion>.png; the version
  // is the cache key, so the URL is immutable and safe to cache forever.
  // Additive + nullable: old deployed code and frozen app binaries never see it.
  assetVersion   String?       @map("asset_version")
  createdAt      DateTime      @default(now()) @map("created_at")

  purchases        UserShopItem[]
  equipped         UserEquippedAccessory[]
  purchaseRequests ShopPurchaseRequest[]

  @@index([active, sortOrder])
  @@map("shop_items")
}

model UserShopItem {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  shopItemId  String   @map("shop_item_id")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@unique([userId, shopItemId])
  @@index([shopItemId])
  @@map("user_shop_items")
}

model UserEquippedAccessory {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  slot       AccessorySlot
  shopItemId String        @map("shop_item_id")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@unique([userId, slot])
  @@index([shopItemId])
  @@map("user_equipped_accessories")
}

model ShopPurchaseRequest {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  idempotencyKey String   @map("idempotency_key")
  shopItemId     String   @map("shop_item_id")
  status         String
  coinsSpent     Int      @default(0) @map("coins_spent")
  resultJson     Json?    @map("result_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([shopItemId])
  @@map("shop_purchase_requests")
}

// ── Powerup store (coin-purchasable powerups) ───────────────────────────────
// A SEPARATE catalog from the cosmetic ShopItem table so that the cosmetic
// catalog (GET /shop/catalog) stays byte-compatible for old app versions. Only
// the new app reads these tables via the new /shop/powerups endpoints.

// Catalog of coin-purchasable powerups (re-buyable, stack in global inventory).
// The SINGLE SOURCE OF TRUTH for user-facing powerup copy (§9.5), keyed by
// PowerupType rather than by SKU: only 6 of the usable types have a shop row, so
// PowerupShopItem could never cover the in-race surfaces. One row per
// user-renderable type; MYSTERY_BOX is intentionally excluded (it is an
// unopened-container inventory state, not a usable powerup with use-sheet or
// effect-rail copy).
//
// Served by GET /powerups/catalog and consumed by getPowerupShopCatalog, which
// keeps its own response SHAPE unchanged for old clients while sourcing `name`
// and `description` from here.
model PowerupCopy {
  powerupType       PowerupType @id @map("powerup_type")
  name              String
  description       String
  // NULLABLE on purpose: only 15 of the 26 pre-existing types have short-form
  // effect-rail copy today. When it is null the client omits the subtitle line
  // entirely rather than substituting a truncated description.
  shortDescription  String?     @map("short_description")
  // 4 entries for upgradeable types ("Extend 1h", "Extend 1.5h", ...), empty
  // otherwise. Tier labels encode durations and drift for the same reason the
  // Leech copy did, so they are data-driven like the upgrade COSTS already are.
  upgradeTierLabels String[]    @map("upgrade_tier_labels")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("powerup_copy")
}

model PowerupShopItem {
  id           String      @id @default(uuid())
  sku          String      @unique
  // DEPRECATED as a source of copy (§9.5.2): retained for additive-schema
  // compatibility and still RETURNED by GET /shop/powerups, but the served
  // strings now come from PowerupCopy. Do not edit these columns to change copy.
  name         String
  description  String?
  priceCoins   Int         @map("price_coins")
  powerupType  PowerupType @map("powerup_type")
  active       Boolean     @default(true)
  // See ShopItem.testOnly — same prod/TestFlight gate for the powerup catalog.
  testOnly     Boolean     @default(false) @map("test_only")
  sortOrder    Int         @default(0) @map("sort_order")
  // See ShopItem.assetVersion. NULL => the icon is bundled in the app binary
  // (PowerupIcon's compiled-in asset map). Non-null => served from
  // /assets/powerups/<powerup_type lowercased>@<assetVersion>.png.
  assetVersion String?     @map("asset_version")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([active, sortOrder])
  @@map("powerup_shop_items")
}

// A user's GLOBAL powerup inventory: how many of each powerup type they own,
// spendable into any active race they're in. One row per (user, type).
model UserPowerupItem {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  powerupType PowerupType @map("powerup_type")
  quantity    Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, powerupType])
  @@index([userId])
  @@map("user_powerup_items")
}

// Idempotency ledger for powerup-store purchases — analogous to
// ShopPurchaseRequest but for the powerup catalog (keeps the cosmetic ledger
// untouched). Keyed on (userId, idempotencyKey).
model PowerupPurchaseRequest {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  idempotencyKey    String   @map("idempotency_key")
  powerupShopItemId String   @map("powerup_shop_item_id")
  status            String
  coinsSpent        Int      @default(0) @map("coins_spent")
  resultJson        Json?    @map("result_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([powerupShopItemId])
  @@map("powerup_purchase_requests")
}

enum PowerupType {
  LEG_CRAMP         @map("leg_cramp")
  RED_CARD          @map("red_card")
  SHORTCUT          @map("shortcut")
  COMPRESSION_SOCKS @map("compression_socks")
  PROTEIN_SHAKE     @map("protein_shake")
  RUNNERS_HIGH      @map("runners_high")
  SECOND_WIND       @map("second_wind")
  STEALTH_MODE      @map("stealth_mode")
  WRONG_TURN        @map("wrong_turn")
  FANNY_PACK        @map("fanny_pack")
  TRAIL_MIX         @map("trail_mix")
  DETOUR_SIGN       @map("detour_sign")
  LUCKY_HORSESHOE   @map("lucky_horseshoe")
  CAMPFIRE_REST     @map("campfire_rest")
  TRAIL_MAGNET      @map("trail_magnet")
  POCKET_WATCH      @map("pocket_watch")
  TRAIL_MINE        @map("trail_mine")
  PINECONE_TOSS     @map("pinecone_toss")
  SNEAKY_SWAP       @map("sneaky_swap")
  MIRROR            @map("mirror")
  CLEANSE           @map("cleanse")
  // IMPOSTER is PURCHASE-ONLY (from the coin store). It is intentionally NOT in
  // any mystery-box rarity tier, so it can never roll from a box. Additive enum
  // value; placed before mystery_box to match the schema's declared ordering.
  IMPOSTER          @map("imposter")
  // RAINSTORM is PURCHASE-ONLY (coin store, like IMPOSTER) and never rolls from
  // a mystery box. Untargeted AoE: halves every OTHER participant's steps for
  // 1 hour. Additive enum value, placed before mystery_box to match ordering.
  RAINSTORM         @map("rainstorm")
  // SIGNAL_JAMMER is STORE-ONLY (coin store, like IMPOSTER / RAINSTORM) and
  // never rolls from a mystery box. Targeted single-target attack: the target
  // cannot USE any powerup in the race for 1 hour. Additive enum value, placed
  // before mystery_box to match the schema's declared ordering.
  SIGNAL_JAMMER     @map("signal_jammer")
  // LEECH is STORE-ONLY (coin store, like IMPOSTER / RAINSTORM / SIGNAL_JAMMER)
  // and never rolls from a mystery box. Targeted, leecher-driven debuff: for 30
  // minutes every step the leecher takes removes one step from the chosen rival
  // (capped at 3000, max 2 leechers per victim). Blocked by Compression Socks,
  // never reflected by a Mirror. Additive enum value, placed before mystery_box.
  LEECH             @map("leech")
  // DEFENSE_SCAN (shipped as "X-Ray") is STORE-ONLY and instantaneous — it grants
  // no timed effect. Using it returns a snapshot of every opponent's active
  // defenses (Compression Socks / Mirror) in the use response. Additive enum
  // value, placed before mystery_box to match the schema's declared ordering.
  DEFENSE_SCAN      @map("defense_scan")
  // HITCHHIKE is STORE-ONLY and never rolls from a mystery box or daily reward
  // box. Targeted, TARGET-driven copy: for 60 minutes the caster COPIES the
  // target's recorded raw steps 1:1 into their own score — the target loses
  // nothing. One active link per caster AND one per target. Compression Socks
  // block it; a Mirror never reflects it. Copied steps do NOT advance mystery-box
  // progress (the term is added at the scoring assembly, never to baseAdjusted).
  // Additive enum value, placed BEFORE mystery_box to match the declared ordering.
  HITCHHIKE         @map("hitchhike")
  // QUICK_RINSE is STORE-ONLY, SELF-ONLY and instantaneous: it HALVES the
  // remaining duration of every active timed opponent-inflicted effect on the
  // user. It creates no effect of its own. Additive enum value, placed BEFORE
  // mystery_box to match the declared ordering.
  QUICK_RINSE       @map("quick_rinse")
  // Store-only multi-target freeze, visible only to powerups4 clients.
  QUICKSAND         @map("quicksand")
  // Powerups Wave 5 (store-only, visible only to `powerups5` clients). All 11
  // are additive enum values placed BEFORE mystery_box to match the schema's
  // declared ordering. See docs/powerups5-wave-requirements.md.
  UPRISING          @map("uprising")
  GHOST_PEPPER      @map("ghost_pepper")
  COIN_FLIP         @map("coin_flip")
  MYSTERY_POTION    @map("mystery_potion")
  DECOY             @map("decoy")
  POWER_OUTAGE      @map("power_outage")
  UMBRELLA          @map("umbrella")
  RALLY_FLAG        @map("rally_flag")
  DRILL_SERGEANT    @map("drill_sergeant")
  PIGGY_BANK        @map("piggy_bank")
  BOUNTY            @map("bounty")
  MYSTERY_BOX       @map("mystery_box")
}

enum PowerupRarity {
  COMMON   @map("common")
  UNCOMMON @map("uncommon")
  RARE     @map("rare")
}

enum PowerupStatus {
  MYSTERY_BOX @map("mystery_box")
  QUEUED      @map("queued")
  HELD        @map("held")
  USED        @map("used")
  DISCARDED   @map("discarded")
  EXPIRED     @map("expired")
}

enum ActiveEffectStatus {
  ACTIVE  @map("active_effect")
  EXPIRED @map("expired_effect")
  BLOCKED @map("blocked")
}

enum RaceStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

enum RaceParticipantStatus {
  INVITED  @map("invited")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
}

enum RacePayoutPreset {
  WINNER_TAKES_ALL @map("winner_takes_all")
  TOP3_70_20_10    @map("top3_70_20_10")
  TOP3_80_15_5     @map("top3_80_15_5")
  // Field-scaled presets (added later): the number of paid places grows with the
  // field. Only emitted by newer app builds; older clients keep sending the
  // three above. See src/utils/racePayoutPresets.js.
  TOP_HALF         @map("top_half")
  ALL_BUT_LAST     @map("all_but_last")
}

enum RaceBuyInStatus {
  NONE      @map("none")
  HELD      @map("held")
  COMMITTED @map("committed")
  REFUNDED  @map("refunded")
}

// Team-race sides (TR-900 Team Race Mode). A team race has exactly two teams;
// every ACCEPTED participant belongs to one. Null on individual races and on
// pre-team-era rows. Additive enum — old app builds never see the column.
enum RaceTeam {
  TEAM_A @map("team_a")
  TEAM_B @map("team_b")
}

model Race {
  id                   String           @id @default(uuid())
  creatorId            String?          @map("creator_id")
  seedId               String?          @map("seed_id")
  name                 String
  targetSteps          Int              @map("target_steps")
  status               RaceStatus       @default(PENDING)
  // maxDurationDays is set on all new races; kept nullable for backward compat
  // with existing rows from the step-goal-only window which have NULL.
  maxDurationDays      Int?             @map("max_duration_days")
  buyInAmount          Int              @default(0) @map("buy_in_amount")
  payoutPreset         RacePayoutPreset @default(WINNER_TAKES_ALL) @map("payout_preset")
  potCoins             Int              @default(0) @map("pot_coins")
  // ── App-funded prize pools ─────────────────────────────────────────────────
  // fundedPrize is the discriminator between the two money models and the ONLY
  // authority at settlement (never the fundedPrizePoolsEnabled flag, so a
  // mid-race flip can't strand a promised prize). true => nobody was charged to
  // enter and the app MINTS players × durationPoints(days) × PRIZE_COIN_UNIT at
  // settlement. false (the default, and every pre-existing row) => the legacy
  // buy-in pot model: HELD/COMMITTED coins pay out or refund exactly as before.
  // The two are mutually exclusive, so no competition can ever pay under both.
  // prizePoolCoins stamps the SETTLED pool so a completed race's numbers can
  // never drift when the accepted/eligible count changes afterwards.
  // Additive with safe legacy defaults — no backfill, and old app builds never
  // read either column.
  fundedPrize          Boolean          @default(false) @map("funded_prize")
  prizePoolCoins       Int              @default(0) @map("prize_pool_coins")
  // How a FUNDED race splits its pool across the paid places of a graded preset
  // (TOP_HALF / ALL_BUT_LAST). Stamped at creation and never rewritten, exactly
  // like fundedPrize: the row is the authority, never the live flag, so an
  // in-flight race can never have its advertised payout table change shape
  // underneath it. NULL (every pre-existing row, and every user-created race)
  // = the even split shipped today; "GEOMETRIC" = the top-heavy 0.7 decay.
  // Only createSeededRace ever writes it. Not serialized to clients.
  payoutCurve          String?          @map("payout_curve")
  // Batch 2026-08-08 item 5: team-race prize-pool multiplier, in basis points,
  // STAMPED AT CREATION from the TEAM_POOL_MULT_* envs and read by BOTH the
  // live projection and settlement so the two can never disagree.
  // NULL = 1.0x = today's formula, which is what every pre-existing race keeps.
  // Because it is stamped, an env edit only affects races created after it —
  // an in-flight race never reprices mid-race.
  teamPoolMultBps      Int?             @map("team_pool_mult_bps")
  startedAt            DateTime?        @map("started_at")
  endsAt               DateTime?        @map("ends_at")
  // Optional future auto-start time (1.1.7). When set and in the future, the
  // race stays PENDING and the autoStartScheduledRaces cron job starts it once
  // this time passes; manual start is blocked until then. Nullable/additive:
  // legacy races and older app clients (which never send it) behave exactly as
  // before — manual instant start.
  scheduledStartAt     DateTime?        @map("scheduled_start_at")
  // Canonical IANA timezone whose calendar-day boundaries define this race's
  // step buckets (e.g. "America/New_York" for seeded daily/weekly challenges).
  // NULL for user-created races, which keep the legacy behavior: live display
  // buckets in the requester's tz, settlement in UTC. When set, BOTH live and
  // settlement bucket in this tz, so "midnight" means the same instant for every
  // participant and live totals match settled totals. Nullable/additive: old app
  // clients never read it; old rows stay NULL and behave exactly as before.
  timezone             String?          @map("timezone")
  completedAt          DateTime?        @map("completed_at")
  winnerUserId         String?          @map("winner_user_id")
  powerupsEnabled      Boolean          @default(false) @map("powerups_enabled")
  powerupStepInterval  Int?             @map("powerup_step_interval")
  isPublic             Boolean          @default(false) @map("is_public")
  // Nullable: NULL means "no participant limit" (unlimited). Older app clients
  // always send an integer, and the @default(10) keeps legacy creates that omit
  // the field unchanged. Additive/backward-compatible — relaxing NOT NULL only.
  maxParticipants      Int?             @default(10) @map("max_participants")
  // When true, the race never finishes on reaching targetSteps; targetSteps is
  // a display-only goal and the winner is decided by step count when ends_at
  // passes (raceExpiry.js). Additive/backward-compatible: defaults false so
  // legacy target races created by older app versions keep finishing on target.
  timeBased            Boolean          @default(false) @map("time_based")
  // Opaque, unguessable token backing shareable race links (https://<host>/r/
  // <token>). Nullable: minted lazily the first time a participant shares the
  // race, so legacy races stay NULL until shared. Additive/backward-compatible —
  // older app clients never read or send it. Unique so a token resolves to at
  // most one race; @unique also creates the lookup index used by findByShareToken.
  shareToken           String?          @unique @map("share_token")
  // ── Team races (TR-100/§12) ────────────────────────────────────────────────
  // isTeamRace flips a race into two-team mode: exactly two sides, team size
  // 1–5, combined team totals, winnerTeam decides. teamSize is the per-side cap
  // (maxParticipants = 2 × teamSize). teamAName/teamBName are the two playful
  // side names (auto-generated at creation, creator-overridable). winnerTeam is
  // the settled result (TEAM_A|TEAM_B|null); winnerUserId stays null for team
  // races. All additive/nullable — old app builds never send or read them, and a
  // race with isTeamRace=false renders exactly as an individual race.
  isTeamRace           Boolean          @default(false) @map("is_team_race")
  teamSize             Int?             @map("team_size")
  teamAName            String?          @map("team_a_name")
  teamBName            String?          @map("team_b_name")
  winnerTeam           RaceTeam?        @map("winner_team")
  // ── Tournaments (bracket mode) ──────────────────────────────────────────────
  // A matchup race is an ordinary time-based WINNER_TAKES_ALL race that belongs
  // to one tournament round. tournamentId != null flags it as a matchup: it is
  // filtered out of every existing race listing for ALL clients and is managed
  // only by the tournament engine (every race-level mutation returns
  // TOURNAMENT_RACE_LOCKED). tournamentRound is 1-based; tournamentMatchIndex is
  // 0-based within the round. The @@unique makes double-advancement a hard DB
  // error (advancement idempotency backstop). All additive/nullable — old app
  // builds never send or read them and old rows stay NULL.
  tournamentId         String?          @map("tournament_id")
  tournamentRound      Int?             @map("tournament_round")
  tournamentMatchIndex Int?             @map("tournament_match_index")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  creator       User?                @relation("raceCreator", fields: [creatorId], references: [id])
  seed          RaceSeed?            @relation(fields: [seedId], references: [id])
  winner        User?                @relation("raceWinner", fields: [winnerUserId], references: [id])
  tournament    Tournament?          @relation(fields: [tournamentId], references: [id])
  participants  RaceParticipant[]
  powerups      RacePowerup[]
  activeEffects RaceActiveEffect[]
  powerupEvents RacePowerupEvent[]
  messages      RaceMessage[]
  resolutionJob RaceResolutionJobV2?

  @@unique([tournamentId, tournamentRound, tournamentMatchIndex])
  @@index([creatorId])
  @@index([status])
  @@index([winnerUserId])
  @@index([isPublic, status])
  @@index([seedId, status])
  @@index([tournamentId, status])
  @@map("races")
}

enum RaceSeedCadence {
  DAILY  @map("daily")
  WEEKLY @map("weekly")
}

model RaceSeed {
  id                  String          @id
  kind                String          @unique
  name                String
  targetSteps         Int             @map("target_steps")
  // durationHours is read for new seeded races to compute endsAt; kept
  // nullable in the schema for backward compat with existing rows.
  durationHours       Int?            @map("duration_hours")
  cadence             RaceSeedCadence
  maxParticipants     Int             @default(100) @map("max_participants")
  // Per-seed powerup config applied to each seeded race created from this seed.
  powerupsEnabled     Boolean         @default(false) @map("powerups_enabled")
  powerupStepInterval Int?            @map("powerup_step_interval")
  // Seeded races created from this seed inherit this flag. Defaults false for
  // backward compat; set true on DAILY_10K/WEEKLY_50K to make them time-based.
  timeBased           Boolean         @default(false) @map("time_based")
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  races Race[]

  @@map("race_seeds")
}

// ── Tournaments (single-elimination bracket mode) ─────────────────────────────
// A Tournament is a bracket of 1v1 winner-take-all step matchups (4/8/16
// players). Each matchup is an ordinary Race (see Race.tournamentId); the
// Tournament layer owns seeding, round advancement, and the coin pot. All new
// tables/columns are additive — old app builds never touch them.
enum TournamentStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

model Tournament {
  id                  String           @id @default(uuid())
  // null = seeded/featured (system-minted), mirrors Race.creatorId.
  creatorId           String?          @map("creator_id")
  // Links to the TournamentSeed for featured brackets; null for user-created.
  seedId              String?          @map("seed_id")
  name                String
  status              TournamentStatus @default(PENDING)
  bracketSize         Int              @map("bracket_size") // 4 | 8 | 16
  matchupDurationDays Int              @map("matchup_duration_days") // 1 | 2 | 3
  // 0 (free), or 10..TOURNAMENT_BUYIN_MAX[bracketSize] = 100/100/62 (D4 ladder).
  buyInAmount         Int              @default(0) @map("buy_in_amount")
  potCoins            Int              @default(0) @map("pot_coins")
  // App-funded bracket pool (same semantics as Race.fundedPrize/prizePoolCoins).
  // Entry is free; the champion is paid a MINTED pool of
  // acceptedPlayers × durationPoints(totalRounds × matchupDurationDays) ×
  // PRIZE_COIN_UNIT, clamped to MAX_CHAMPION_PRIZE. Mutually exclusive with both
  // the legacy pot payout and a featured seed's championPrizeCoins.
  fundedPrize         Boolean          @default(false) @map("funded_prize")
  prizePoolCoins      Int              @default(0) @map("prize_pool_coins")
  powerupsEnabled     Boolean          @default(false) @map("powerups_enabled")
  powerupStepInterval Int?             @map("powerup_step_interval")
  isPublic            Boolean          @default(false) @map("is_public")
  shareToken          String?          @unique @map("share_token")
  // Creator's IANA zone at creation; "America/New_York" for seeded. Matchup
  // races inherit it as their canonical scoring tz.
  timezone            String?          @map("timezone")
  currentRound        Int              @default(0) @map("current_round") // 0 = not started
  totalRounds         Int              @map("total_rounds") // log2(bracketSize)
  championUserId      String?          @map("champion_user_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  startedAt           DateTime?        @map("started_at")
  completedAt         DateTime?        @map("completed_at")

  creator      User?                   @relation("TournamentCreator", fields: [creatorId], references: [id])
  champion     User?                   @relation("TournamentChampion", fields: [championUserId], references: [id])
  seed         TournamentSeed?         @relation(fields: [seedId], references: [id])
  participants TournamentParticipant[]
  races        Race[]

  @@index([isPublic, status])
  @@index([creatorId, status])
  @@index([seedId, status])
  @@map("tournaments")
}

model TournamentSeed {
  id                  String   @id // stable key, e.g. "seed-tournament-daily-dash"
  kind                String   @unique @map("kind") // e.g. "DAILY_DASH"
  name                String // copied verbatim to each minted tournament
  bracketSize         Int      @map("bracket_size")
  matchupDurationDays Int      @map("matchup_duration_days")
  powerupsEnabled     Boolean  @default(false) @map("powerups_enabled")
  powerupStepInterval Int?     @map("powerup_step_interval")
  championPrizeCoins  Int      @map("champion_prize_coins") // minted prize (featured are always free); <= 1000
  active              Boolean  @default(true) // reconciler only reconciles active seeds
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tournaments Tournament[]

  @@map("tournament_seeds")
}

model TournamentParticipant {
  id                String                @id @default(uuid())
  tournamentId      String                @map("tournament_id")
  userId            String                @map("user_id")
  // Reuse the race participant status enum (INVITED/ACCEPTED/DECLINED).
  status            RaceParticipantStatus @default(INVITED)
  seed              Int? // bracket slot 0..bracketSize-1, assigned at start
  eliminatedInRound Int?                  @map("eliminated_in_round") // null = still alive (or champion)
  buyInAmount       Int                   @default(0) @map("buy_in_amount")
  // Reuse the race buy-in status enum (NONE/HELD/COMMITTED/REFUNDED).
  buyInStatus       RaceBuyInStatus       @default(NONE) @map("buy_in_status")
  // Increments on every refund; suffixes ledger refIds so a re-hold after
  // leave->rejoin can never silently no-op against an old ledger row (§7).
  buyInVersion      Int                   @default(0) @map("buy_in_version")
  // ACCEPT time (updated on re-accept); the D3 exact-tie tiebreak key.
  joinedAt          DateTime              @default(now()) @map("joined_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([userId, status])
  @@map("tournament_participants")
}

model RaceParticipant {
  id                       String                @id @default(uuid())
  raceId                   String                @map("race_id")
  userId                   String                @map("user_id")
  status                   RaceParticipantStatus @default(INVITED)
  totalSteps               Int                   @default(0) @map("total_steps")
  // When `totalSteps` was last persisted (batch 2026-07-26, item 16). GET /races
  // keeps serving the cheap PERSISTED team totals — no live recompute on the
  // hottest screen — and now surfaces max(totalsUpdatedAt) as `teams.asOf` so the
  // client can render "as of N min ago" instead of a silently stale number.
  // Additive/nullable: NULL simply means "never written since this deploy", and
  // the client hides the staleness affordance. Written in the same UPDATE that
  // writes totalSteps, so it costs no extra round-trip.
  totalsUpdatedAt          DateTime?             @map("totals_updated_at")
  // RAW WALKED steps (`baseAdjusted`) as of the last persist — the same
  // manipulation-proof quantity box progress uses: no buffs, no debuffs, no
  // bonus steps, so it only ever grows by walking. Written by every writer of
  // `totalSteps` (legacy replay persist, the v2 worker's fenced replay, and the
  // step-upload reconcile). Frozen (finished/forfeited) rows keep their last
  // persisted value.
  //
  // MONOTONIC PER WRITER, with a bounded race window — NOT a strict
  // never-decreases guarantee. Each writer high-waters the value it writes
  // (`max(existing, baseAdjusted)`), which is what stops a downward re-sync of
  // step_samples from walking a player's odds position backwards. But the
  // worker reads `existing` OUTSIDE its write transaction, so a concurrent
  // reconcile write that lands in between can be clobbered by up to one sync
  // interval's worth of steps. Accepted: it is the same last-writer-wins shape
  // `total_steps` itself already has, and the worst case is odds computed from
  // a slightly stale raw total that the next persist repairs.
  //
  // Read ONLY as the mystery-box drop-odds position (openMysteryBox,
  // rerollMysteryBox, getRaceProgress's dropOdds) via the shared
  // `rawPositionFor` helper. NULL = never persisted since the deploy; if ANY
  // accepted participant of a race is NULL the whole race falls back to
  // `totalSteps`. Additive/nullable, no index (never a query predicate), and
  // never returned by any API — old app versions are unaffected.
  rawSteps                 Int?                  @map("raw_steps")
  baselineSteps            Int                   @default(0) @map("baseline_steps")
  nextBoxAtSteps           Int                   @default(0) @map("next_box_at_steps")
  bonusSteps               Int                   @default(0) @map("bonus_steps")
  maxBonusSteps            Int                   @default(0) @map("max_bonus_steps")
  // DEPRECATED / UNUSED. Was a box-progress high-water anchor meant to make box
  // progress immune to Leg Cramp/Wrong Turn, but it froze the countdown while a
  // player sat below their pre-debuff peak. Product decision: box progress is
  // debuff-sensitive (the bonusSteps high-water still protects bonus-steal). No
  // code reads this column anymore; it is retained (not dropped) to avoid a
  // destructive migration. Safe to remove in a future schema-cleanup release.
  maxBoxProgressSteps      Int?                  @map("max_box_progress_steps")
  powerupSlots             Int                   @default(3) @map("powerup_slots")
  buyInAmount              Int                   @default(0) @map("buy_in_amount")
  buyInStatus              RaceBuyInStatus       @default(NONE) @map("buy_in_status")
  // Monotonic per-participant edit counter (Issue 4). Bumped each time the owner
  // reconciles the buy-in on a PENDING race; the versioned value forms a unique
  // coin-ledger refId (`<raceId>:<userId>:v<n>`) so a re-charge after a refund is
  // never silently skipped by awardCoins idempotency. Additive, default 0 — old
  // rows and old app versions are unaffected (nothing reads it client-side).
  buyInVersion             Int                   @default(0) @map("buy_in_version")
  payoutCoins              Int                   @default(0) @map("payout_coins")
  placement                Int?
  // Live placement broadcast (Phase 0): last live rank we pushed to this
  // participant, for idempotent change detection in placementRecompute. NULL =
  // baseline not yet seeded. Additive + nullable; never returned by any API
  // response, so already-shipped app versions are unaffected.
  lastNotifiedPlacement    Int?                  @map("last_notified_placement")
  // High-multiplier alert dedup (item 6b): the moment we last emitted a
  // HIGH_MULTIPLIER_ALERT because this participant's current (stacked,
  // event-inclusive) multiplier crossed above the threshold. Set on emit,
  // CLEARED when the multiplier drops back to <= threshold so the alert re-arms
  // for the next spike. Additive + nullable; never returned by any API response,
  // so already-shipped app versions are unaffected.
  highMultiplierNotifiedAt DateTime?             @map("high_multiplier_notified_at")
  finishedAt               DateTime?             @map("finished_at")
  finishTotalSteps         Int?                  @map("finish_total_steps")
  joinedAt                 DateTime              @default(now()) @map("joined_at")
  lastReadRaceChatAt       DateTime?             @map("last_read_race_chat_at")
  lastChatPushAt           DateTime?             @map("last_chat_push_at")
  chatMuted                Boolean               @default(false) @map("chat_muted")
  // Per-race opt-out for live placement-change pushes (Phase 0). When true, the
  // placementRecompute job keeps this participant's lastNotifiedPlacement baseline
  // in sync but emits no PLACEMENT_CHANGED event, so they get neither the visible
  // alert nor the silent refresh for this race. Additive + default-false: old app
  // versions never set it and behave exactly as before.
  placementAlertsMuted     Boolean               @default(false) @map("placement_alerts_muted")
  // Daily biggest-mover digest: this participant's live rank captured at the last
  // 4pm-ET digest run, the baseline the next run measures movement against (a
  // rolling 24h window). NULL = not yet seeded; the digest job lazily seeds it and
  // emits nothing for that first partial window. Reset to the current live rank on
  // every run. Additive + nullable; never returned by any API, so already-shipped
  // app versions are unaffected.
  dayStartPlacement        Int?                  @map("day_start_placement")
  inviteExpiresAt          DateTime?             @map("invite_expires_at")
  resultsSeenAt            DateTime?             @map("results_seen_at")
  // Team-race side (TR-201). Null on individual races and on pre-team-era rows.
  // Set at join/accept for team races; freely switchable while PENDING, locked
  // at start. Additive/nullable — old app builds never read it.
  team                     RaceTeam?
  // Mid-race forfeit moment (TR-601, team races only). When set, the member's
  // effective total is FROZEN as-is into totalSteps (active debuffs bite
  // permanently — no re-derivation), they stop accruing, can't use or be
  // targeted by powerups, and get no payout cut even on the winning team.
  // Null = never forfeited. Additive/nullable — old app builds never read it.
  forfeitedAt              DateTime?             @map("forfeited_at")

  race                  Race               @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user                  User               @relation(fields: [userId], references: [id])
  powerups              RacePowerup[]
  activeEffectsReceived RaceActiveEffect[]

  @@unique([raceId, userId])
  @@index([userId, status])
  @@index([raceId, status])
  @@index([userId, status, inviteExpiresAt])
  @@map("race_participants")
}

model RacePowerup {
  id            String         @id @default(uuid())
  raceId        String         @map("race_id")
  participantId String         @map("participant_id")
  userId        String         @map("user_id")
  type          PowerupType?
  rarity        PowerupRarity?
  status        PowerupStatus  @default(HELD)
  earnedAtSteps Int?           @map("earned_at_steps")
  usedAt        DateTime?      @map("used_at")
  targetUserId  String?        @map("target_user_id")
  upgradeLevel  Int            @default(0) @map("upgrade_level")
  // Balance-config version that produced this roll (D9 provenance). Nullable and
  // additive: rows created before balance config shipped stay NULL, and a roll
  // that happens while the config table is unreadable (code-defaults fallback)
  // also stays NULL. Stamped only where rarity is actually decided —
  // openMysteryBox / openMysteryBoxBatch — never in rollPowerup, which mints
  // unopened MYSTERY_BOX rows and rolls nothing.
  configVersion Int?           @map("config_version")
  // Batch 2026-08-08 item 11: when this rolled powerup was rerolled via a
  // rewarded ad. NULL = never rerolled (true of every pre-existing row), which
  // is what the once-per-roll guard tests. Additive/nullable.
  rerolledAt    DateTime?      @map("rerolled_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  race          Race               @relation(fields: [raceId], references: [id], onDelete: Cascade)
  participant   RaceParticipant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  activeEffects RaceActiveEffect[]

  @@unique([participantId, earnedAtSteps])
  @@index([participantId, status])
  @@index([raceId, userId])
  @@map("race_powerups")
}

model PowerupUpgradeEvent {
  id           String      @id @default(uuid())
  raceId       String      @map("race_id")
  userId       String      @map("user_id")
  powerupId    String      @map("powerup_id")
  powerupType  PowerupType @map("powerup_type")
  tier         Int
  costCoins    Int         @map("cost_coins")
  status       String
  targetUserId String?     @map("target_user_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([raceId, createdAt])
  @@map("powerup_upgrade_events")
}

model RaceActiveEffect {
  id                  String             @id @default(uuid())
  raceId              String             @map("race_id")
  targetParticipantId String             @map("target_participant_id")
  targetUserId        String             @map("target_user_id")
  sourceUserId        String             @map("source_user_id")
  powerupId           String             @map("powerup_id")
  type                PowerupType
  status              ActiveEffectStatus @default(ACTIVE)
  startsAt            DateTime           @map("starts_at")
  expiresAt           DateTime?          @map("expires_at")
  metadata            Json?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  race              Race            @relation(fields: [raceId], references: [id], onDelete: Cascade)
  targetParticipant RaceParticipant @relation(fields: [targetParticipantId], references: [id], onDelete: Cascade)
  powerup           RacePowerup     @relation(fields: [powerupId], references: [id], onDelete: Cascade)

  // One effect per (powerup, victim). AoE powerups (Rainstorm) fan one powerup
  // out to N victims, so powerupId alone can't be unique — but the same storm
  // must not double-apply to the same participant.
  @@unique([powerupId, targetParticipantId])
  @@index([targetParticipantId, status])
  @@index([raceId, status])
  @@map("race_active_effects")
}

model RacePowerupEvent {
  id           String       @id @default(uuid())
  raceId       String       @map("race_id")
  actorUserId  String       @map("actor_user_id")
  eventType    String       @map("event_type")
  powerupType  PowerupType? @map("powerup_type")
  targetUserId String?      @map("target_user_id")
  description  String
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, createdAt])
  @@map("race_powerup_events")
}

enum RaceMessageKind {
  USER   @map("user")
  SYSTEM @map("system")
}

model RaceMessage {
  id        String          @id @default(uuid())
  raceId    String          @map("race_id")
  senderId  String?         @map("sender_id")
  kind      RaceMessageKind @default(USER)
  body      String          @db.VarChar(500)
  createdAt DateTime        @default(now()) @map("created_at")
  deletedAt DateTime?       @map("deleted_at")

  race   Race  @relation(fields: [raceId], references: [id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id])

  @@index([raceId, createdAt])
  @@map("race_messages")
}

// One-time ledger of the "join your first race" bonus mystery-box grant.
// Keyed on a SHA-256 hash of the Apple `sub` (stored, never the raw sub) so the
// gate survives account deletion + reinstall + re-sign-in (which mints a new
// User row but reuses the same Apple sub). Rows are intentionally NEVER deleted
// on account deletion — that is what makes the grant abuse-proof.
model OnboardingBoxGrant {
  appleSubHash String   @id @map("apple_sub_hash")
  grantedAt    DateTime @default(now()) @map("granted_at")

  @@map("onboarding_box_grant")
}

// ── Friend referrals ───────────────────────────────────────────────────────
// Attribution ledger: who referred whom. One row per referred human, written
// once in the new-user create branch at signup (M1). The ENFORCED dedup is on
// the referee's provider-sub hash (stable across delete+reinstall), NOT on the
// reinstallable referee id — so a delete-account+reinstall human can't be
// re-attributed. referrerId is nullable + onDelete:SetNull so a referrer
// deleting their account never destroys the attribution row or the referee's
// pending reward (the grant code tolerates a null referrer). See §4B.
model Referral {
  id             String   @id @default(uuid())
  referrerId     String?  @map("referrer_id") // nullable: SetNull on referrer delete
  refereeId      String   @unique @map("referee_id")
  refereeSubHash String   @unique @map("referee_sub_hash") // hashAppleSub(referee appleId||googleSub)
  code           String? // code used at signup, if any
  status         String   @default("PENDING") // PENDING -> QUALIFIED -> REWARDED -> EXPIRED
  // WHICH MECHANISM attributed this referral (invite-code onboarding spec, part
  // B). Plain string, not an enum, to match `status` in this same table and to
  // keep adding a mechanism a code-only change. Values and their SINGLE write
  // sites:
  //   provision_body     recordReferral, code came in the /auth/* body
  //   ip_fallback_exact  recordReferral, findLinkOpenReferralCode tier 1
  //   ip_fallback_net    recordReferral, findLinkOpenReferralCode tier 2
  //   redeem             redeemReferralCode (onboarding step / referral screen)
  //   repair             reserved for ops scripts — never written by app code
  // NULL = attributed before this column existed (no backfill by design).
  // Load-bearing beyond observability: redeemReferralCode reads it to decide
  // whether an explicit manual redeem may REPLACE a weak `ip_fallback_net`
  // guess (see that command) — so a wrong tier-2 match can never be permanent.
  source         String?
  createdAt      DateTime @default(now()) @map("created_at")

  referrer     User?                 @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: SetNull)
  referee      User                  @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  rewardGrants ReferralRewardGrant[]

  @@index([referrerId])
  @@map("referrals")
}

// Payout ledger: which side was paid. Minted at the referee's first qualifying
// race completion (M2). Inserting this row FIRST inside the grant $transaction
// makes the payout exactly-once per human per role across delete+reinstall —
// the @@unique([refereeSubHash, role]) collides before any coin mints. Mirrors
// OnboardingBoxGrant's insert-first idempotency.
//
// userId is nullable + onDelete:SetNull (NOT Cascade) on purpose: the abuse
// ledger MUST outlive the account, exactly like OnboardingBoxGrant (which has no
// user FK at all). If a referee's REFEREE-role row were cascade-deleted on
// account deletion, a delete+reinstall referee would get a fresh refereeSubHash
// slot and could re-farm their own reward (§8.2). SetNull keeps only the hash +
// role (privacy-safe — no PII), preserving the exactly-once guard forever.
// referralId is likewise nullable so a SetNull'd/Cascade-deleted referral keeps
// this audit row. See §4C.
model ReferralRewardGrant {
  id             String   @id @default(uuid())
  referralId     String?  @map("referral_id")
  userId         String?  @map("user_id") // who received the reward (null after that account is deleted)
  role           String // "REFERRER" | "REFEREE"
  refereeSubHash String   @map("referee_sub_hash") // abuse key: provider-sub hash of the REFEREE
  coins          Int?
  grantedAt      DateTime @default(now()) @map("granted_at")

  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([refereeSubHash, role]) // EXACTLY-ONCE PER HUMAN PER ROLE — primary anti-farming guard
  @@index([refereeSubHash])
  @@index([userId])
  @@map("referral_reward_grants")
}

// ── Ranked ─────────────────────────────────────────────────────────────────
// A competitive ladder driven by walking. Each ~monthly Season accrues Ranked
// Points (RP) per user (derived from existing Step rows — see RANKED.md), and a
// background job settles the season: ranks everyone, assigns tiers, mints
// rewards, then opens the next season. All additive — old app versions never
// touch any of this.

enum SeasonStatus {
  ACTIVE   @map("active")
  SETTLING @map("settling")
  CLOSED   @map("closed")
}

model Season {
  id        String       @id @default(uuid())
  index     Int          @unique
  startsAt  DateTime     @map("starts_at")
  endsAt    DateTime     @map("ends_at")
  status    SeasonStatus @default(ACTIVE)
  settledAt DateTime?    @map("settled_at")
  createdAt DateTime     @default(now()) @map("created_at")

  scores SeasonScore[]

  @@index([status])
  @@map("seasons")
}

model SeasonScore {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  seasonId            String   @map("season_id")
  // points = carryOverSeed (soft-reset head start) + earnedPoints (RP from this
  // season's activity). Tiering and the ladder rank on `points`.
  points              Int      @default(0)
  carryOverSeed       Int      @default(0) @map("carry_over_seed")
  earnedPoints        Int      @default(0) @map("earned_points")
  // Provisional standings, refreshed each job tick while the season is live.
  provisionalRank     Int?     @map("provisional_rank")
  provisionalTier     String?  @map("provisional_tier")
  provisionalDivision Int?     @map("provisional_division")
  // Final standings, locked at settlement.
  rank                Int?
  tier                String?
  division            Int?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, points])
  @@map("season_scores")
}

// ── Ranked v2: weekly cohorts ────────────────────────────────────────────────
// Persistent-tier, weekly-cohort ladder (see RANKED_V2.md). Every Monday (date
// axis, matching Step.date semantics) a RankedWeek opens and players are
// grouped into ~30-person same-tier cohorts. Score = raw weekly step total.
// Settlement promotes the top zone, demotes the bottom zone, mints coins, and
// updates User.rankedTierV2 (+ the legacy-mapped User.currentTier for old
// clients). All additive — the legacy Season tables above stay untouched and
// keep serving GET /ranked for shipped app versions.

enum RankedWeekStatus {
  ACTIVE   @map("active")
  SETTLING @map("settling")
  CLOSED   @map("closed")
}

model RankedWeek {
  id        String           @id @default(uuid())
  index     Int              @unique
  // Half-open [startsOn, endsOn) on the UTC-midnight date axis (Mon..next Mon).
  startsOn  DateTime         @map("starts_on")
  endsOn    DateTime         @map("ends_on")
  status    RankedWeekStatus @default(ACTIVE)
  settledAt DateTime?        @map("settled_at")
  createdAt DateTime         @default(now()) @map("created_at")

  cohorts RankedCohort[]
  members RankedCohortMember[]

  @@index([status])
  @@map("ranked_weeks")
}

model RankedCohort {
  id        String   @id @default(uuid())
  weekId    String   @map("week_id")
  tier      String // BRONZE | SILVER | GOLD | PLATINUM | DIAMOND | LEGEND
  createdAt DateTime @default(now()) @map("created_at")

  week    RankedWeek           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  members RankedCohortMember[]

  @@index([weekId, tier])
  @@map("ranked_cohorts")
}

model RankedCohortMember {
  id              String    @id @default(uuid())
  // weekId is denormalized from the cohort so (weekId, userId) can be unique:
  // one cohort per user per week.
  weekId          String    @map("week_id")
  cohortId        String    @map("cohort_id")
  userId          String    @map("user_id")
  // Home tier at assignment (the cohort's tier; kept per-member so history
  // survives cohort deletion/rebalance).
  tier            String
  // Live score: raw step total for the week, refreshed each job tick.
  weeklySteps     Int       @default(0) @map("weekly_steps")
  provisionalRank Int?      @map("provisional_rank")
  // Settlement results, locked once the week closes.
  finalRank       Int?      @map("final_rank")
  outcome         String? // PROMOTE | HOLD | DEMOTE
  resultTier      String?   @map("result_tier") // home tier after settlement
  rewardCoins     Int?      @map("reward_coins")
  promotionCoins  Int?      @map("promotion_coins")
  // Display-only ack: set when the user has seen the post-settlement summary
  // popup for this week. NULL = unseen. Additive; old app builds never read it.
  resultsSeenAt   DateTime? @map("results_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort RankedCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  week   RankedWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, userId])
  @@index([cohortId, weeklySteps])
  @@map("ranked_cohort_members")
}

// BeReal-style global step-multiplier event. During [startsAt, endsAt) steps
// taken by ALL participants in ALL active races are multiplied by `multiplier`
// (stacking multiplicatively with per-participant powerup multipliers). Created
// ~3x/day by the scheduler (src/jobs/globalStepEventScheduler.js); read by the
// SHARED resolution so display (getRaceProgress) and settlement (raceExpiry)
// agree. Additive, never read by old app binaries (which simply see a higher,
// correct step total during a window).
model GlobalStepEvent {
  id         String   @id @default(uuid())
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  multiplier Float    @default(2)
  label      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("global_step_events")
}

// Audit log of every user-facing (visible) push we send. Written at each visible
// send site in notificationHandlers.js; silent refresh pushes are NOT recorded.
// `type` is a free-form String (the push payload's `type`, e.g. RACE_STARTED,
// race_message, PLACEMENT_CHANGED, DAILY_MOVER) rather than an enum, so new
// notification kinds don't need a migration. A nightly job prunes rows older than
// a week. Storage-only for now (queried directly when debugging); no API exposes
// it, so old clients are unaffected.
model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  title       String?
  body        String?
  raceId      String?  @map("race_id")
  // Cross-process atomic-claim key for the daily-reward reminder scheduler
  // (§7). The job INSERTs a deterministic key (daily-reward:<userId>:<localDate>:<slot>)
  // BEFORE sending and only sends on a successful insert, so two cluster workers
  // can never double-send. Null for EVERY other writer. The unique index is
  // PARTIAL (WHERE delivery_key IS NOT NULL) — see the migration SQL; the
  // @unique here is what keeps Prisma's index name stable, the migration adds the
  // predicate. Postgres treats nulls as distinct, so existing null writers never
  // collide regardless.
  deliveryKey String?  @unique @map("delivery_key")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// Once-per-day idempotency marker for ET-anchored cron jobs (notification
// cleanup @1am ET, daily-mover digest @4pm ET). `lastRanFor` stores the ET
// calendar day (YYYY-MM-DD) the job last completed for, so a job fires exactly
// once per ET day even across the frequent process restarts and regardless of
// DST. Keyed by job name; one row per job.
model JobRun {
  jobName    String   @id @map("job_name")
  lastRanFor String   @map("last_ran_for")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("job_runs")
}

// Runtime feature flags / app settings, toggleable from the admin screen
// without a deploy. One row per key; value is free-form JSON so new flags
// don't need a migration. Read through src/services/appSettings.js (cached).
// Per-environment by design (prod and staging flip independently — unlike
// shop items, settings are NOT mirrored to the peer DB).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Versioned, append-only game-balance configuration (rarity, drop pools,
// position-odds curves, upgrade ladders, daily-box curves). Exactly one row has
// active = true; every save writes a NEW row rather than mutating an old one,
// so history is a full audit trail and rollback is a copy-forward.
//
// `version` is assigned by the APPLICATION inside the write transaction
// (SELECT ... FOR UPDATE on the newest row), NOT by @default(autoincrement()) —
// Prisma only supports autoincrement on @id for this connector.
//
// Per-environment on purpose (D3): prod and staging are tuned independently and
// nothing is mirrored, so staging stays usable as a balance test bed.
model BalanceConfig {
  id            String   @id @default(uuid())
  version       Int      @unique
  config        Json
  note          String?
  createdBy     String?  @map("created_by")
  boundOverride Boolean  @default(false) @map("bound_override")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([active])
  @@map("balance_config")
}

// Top-of-funnel tap log for /r/<token> landing-page opens (referral codes and
// race share links). One row per page view; feeds the invite-funnel numbers in
// GET /admin/stats. Append-only, no user linkage (the viewer is anonymous).
model LinkOpen {
  id        String   @id @default(uuid())
  kind      String // "referral" | "race_share"
  code      String? // normalized referral code, or the race share token
  // SHA-256 hash of the viewer's client IP (never the raw IP — the viewer is
  // anonymous and stays that way). Powers IP-correlated deferred referral
  // attribution: a codeless signup from the same hashed IP within the fallback
  // window attributes to the code opened here. Nullable/additive — old rows and
  // opens with no resolvable IP simply never match.
  ipHash    String?  @map("ip_hash")
  // SHA-256 hash of the viewer's NETWORK PREFIX (IPv4 /24, IPv6 /64) — tier 2
  // of the two-tier fallback. The exact-IP match breaks whenever the landing
  // page and the app egress from different addresses on the same network
  // (IPv4<->IPv6, Wi-Fi<->cellular, NAT churn); the prefix survives that.
  // Same privacy posture as ipHash: only the hash is ever persisted.
  //
  // Nullable/additive. Old rows stay NULL and age out of the 48h window within
  // two days of deploy, so no backfill. A NULL here must NEVER be used as a
  // match key — `where: { ipNetHash: null }` would match every legacy row at
  // once; findLinkOpenReferralCode skips tier 2 entirely on a null hash.
  ipNetHash String?  @map("ip_net_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([ipHash, createdAt])
  @@index([ipNetHash, createdAt])
  @@map("link_opens")
}

// ── Async step sync (Home/Races Refresh Performance) ─────────────────────────
// Two ADDITIVE tables backing POST /steps/sync-v2 and the durable race-
// resolution worker. Old backend code ignores them; old app builds never call
// the v2 endpoint (they keep POST /steps + POST /steps/samples). Nothing here
// removes or changes an existing column, so a mixed-version deploy is safe.

// Server-side idempotency reservation for one sync-v2 attempt group. Keyed by
// (userId, idempotencyKey): the first valid request persists data and stores its
// canonical response; a same-hash replay reads the stored response; a different-
// hash reuse of the key is a 409 conflict. `requestHash` is the SHA-256 hex of
// the canonical request. `resolutionTimeZone` persists the validated request tz
// so recovery/finalization never has to re-derive it. Rows retain ~7 days.
enum StepSyncRequestState {
  PROCESSING @map("processing")
  COMPLETE   @map("complete")
}

model StepSyncRequest {
  id                 String               @id @default(uuid())
  userId             String               @map("user_id")
  idempotencyKey     String               @map("idempotency_key") @db.VarChar(36)
  requestHash        String               @map("request_hash") @db.Char(64)
  resolutionTimeZone String               @map("resolution_time_zone") @db.VarChar(255)
  state              StepSyncRequestState @default(PROCESSING)
  responseJson       Json?                @map("response_json")
  // Non-null while an owner is performing the uploader reconciliation between
  // Transaction A and B; an expired lease is reclaimable for idempotent recovery.
  leaseExpiresAt     DateTime?            @map("lease_expires_at")
  // Set exactly once, under a conditional `eventsEmittedAt IS NULL` claim, so a
  // replay/recovery can never re-emit STEPS_RECORDED/STEPS_UPDATED.
  eventsEmittedAt    DateTime?            @map("events_emitted_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  expiresAt          DateTime             @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([expiresAt])
  @@map("step_sync_requests")
}

// One durable full-field race-resolution job PER USER (unique userId). Enqueue
// is an upsert that bumps `generation` and sets QUEUED; the worker claims rows
// with FOR UPDATE SKIP LOCKED, snapshots the generation + tz into
// processingGeneration/processingTimeZone, and only records success when the
// claimed generation still matches. A newer generation supersedes an older
// polled one. `resolutionTimeZone`/`processingTimeZone` are the validated IANA
// request tz — the worker NEVER infers tz from server locale/UTC.
enum RaceResolutionJobState {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
}

model RaceResolutionJob {
  id                   String                 @id @default(uuid())
  userId               String                 @unique @map("user_id")
  generation           Int                    @default(1)
  processingGeneration Int?                   @map("processing_generation")
  resolutionTimeZone   String                 @map("resolution_time_zone") @db.VarChar(255)
  processingTimeZone   String?                @map("processing_time_zone") @db.VarChar(255)
  state                RaceResolutionJobState @default(QUEUED)
  attempts             Int                    @default(0)
  requestedAt          DateTime               @map("requested_at")
  startedAt            DateTime?              @map("started_at")
  completedAt          DateTime?              @map("completed_at")
  retryAt              DateTime?              @map("retry_at")
  leaseExpiresAt       DateTime?              @map("lease_expires_at")
  lastErrorCode        String?                @map("last_error_code")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, retryAt])
  @@index([leaseExpiresAt])
  @@map("race_resolution_jobs")
}

// C0 (Redis derived-data spec §5a) — the RACE-KEYED resolution queue. One row
// per race (unique raceId): the worker that claims it is the SOLE bulk writer of
// that race's race_participants rows, and raceExpiry acquires the same row
// FOR UPDATE before settling, so a live resolve and a settlement can never both
// be mid-write on one race.
//
// EXPAND phase: this table is created ALONGSIDE the old per-user
// `race_resolution_jobs`, which is left completely untouched so old binaries
// draining it during a `pm2 reload` overlap never see a schema they don't
// expect. The contract migration (drop old table) ships >= 1 week later.
//
// Extra columns over v1:
//  - leaseToken                   fencing token minted at claim; the write
//                                 transaction re-acquires the row
//                                 `WHERE id = ? AND lease_token = ?` FOR UPDATE
//                                 BEFORE touching any participant row.
//  - notBeforeAt                  explicit debounce floor written by
//                                 recordSuccess (now + RACE_RESOLVE_DEBOUNCE_MS).
//  - triggeredByUserIds           append-distinct list of users whose enqueue
//                                 made this race dirty (box state / nudges).
//  - processingTriggeredByUserIds snapshot moved over at claim; survives a
//                                 crash so a re-claim UNIONs it back in and no
//                                 triggering user is ever dropped.
//  - lastCompletedAt              last successful resolve (debounce/observability).
model RaceResolutionJobV2 {
  id                           String                 @id @default(uuid())
  raceId                       String                 @unique @map("race_id")
  generation                   Int                    @default(1)
  processingGeneration         Int?                   @map("processing_generation")
  resolutionTimeZone           String?                @map("resolution_time_zone") @db.VarChar(255)
  processingTimeZone           String?                @map("processing_time_zone") @db.VarChar(255)
  state                        RaceResolutionJobState @default(QUEUED)
  attempts                     Int                    @default(0)
  requestedAt                  DateTime               @map("requested_at")
  startedAt                    DateTime?              @map("started_at")
  completedAt                  DateTime?              @map("completed_at")
  lastCompletedAt              DateTime?              @map("last_completed_at")
  retryAt                      DateTime?              @map("retry_at")
  notBeforeAt                  DateTime?              @map("not_before_at")
  leaseExpiresAt               DateTime?              @map("lease_expires_at")
  leaseToken                   String?                @map("lease_token")
  lastErrorCode                String?                @map("last_error_code")
  triggeredByUserIds           Json                   @default("[]") @map("triggered_by_user_ids")
  processingTriggeredByUserIds Json                   @default("[]") @map("processing_triggered_by_user_ids")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([state, retryAt])
  @@index([leaseExpiresAt])
  @@index([state, notBeforeAt])
  @@index([requestedAt])
  @@map("race_resolution_jobs_v2")
}
