  race         Race              @relation(fields: [raceId], references: [id], onDelete: Cascade)
  impactEvents RaceImpactEvent[]

  @@index([raceId, createdAt])
  // Batch 2026-08-10 item 1: the seeded-race auto-enroll flip asks "did any of
  // these N users open a mystery box since <instant>?" on every renewal tick.
  // Three columns because the predicate always pins event_type, and the table
  // is dominated by other event types. (A partial index on
  // event_type = 'MYSTERY_BOX_OPENED' would be tighter, but Prisma can't
  // express one without permanent schema drift.)
  @@index([actorUserId, eventType, createdAt])
  @@map("race_powerup_events")
}

enum RaceMessageKind {
  USER   @map("user")
  SYSTEM @map("system")
}

model RaceMessage {
  id        String          @id @default(uuid())
  raceId    String          @map("race_id")
  senderId  String?         @map("sender_id")
  kind      RaceMessageKind @default(USER)
  body      String          @db.VarChar(500)
  createdAt DateTime        @default(now()) @map("created_at")
  deletedAt DateTime?       @map("deleted_at")

  race   Race  @relation(fields: [raceId], references: [id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id])

  @@index([raceId, createdAt])
  // Raw migration artifact (Prisma cannot model its partial predicate/order):
  // race_messages_user_watermark_idx on
  // (race_id, kind, created_at DESC, id DESC) WHERE deleted_at IS NULL.
  @@map("race_messages")
}

// One-time ledger of the "join your first race" bonus mystery-box grant.
// Keyed on a SHA-256 hash of the Apple `sub` (stored, never the raw sub) so the
// gate survives account deletion + reinstall + re-sign-in (which mints a new
// User row but reuses the same Apple sub). Rows are intentionally NEVER deleted
// on account deletion — that is what makes the grant abuse-proof.
model OnboardingBoxGrant {
  appleSubHash String   @id @map("apple_sub_hash")
  grantedAt    DateTime @default(now()) @map("granted_at")

  @@map("onboarding_box_grant")
}

// ── Friend referrals ───────────────────────────────────────────────────────
// Attribution ledger: who referred whom. One row per referred human, written
// once in the new-user create branch at signup (M1). The ENFORCED dedup is on
// the referee's provider-sub hash (stable across delete+reinstall), NOT on the
// reinstallable referee id — so a delete-account+reinstall human can't be
// re-attributed. referrerId is nullable + onDelete:SetNull so a referrer
// deleting their account never destroys the attribution row or the referee's
// pending reward (the grant code tolerates a null referrer). See §4B.
model Referral {
  id               String    @id @default(uuid())
  referrerId       String?   @map("referrer_id") // nullable: SetNull on referrer delete
  refereeId        String    @unique @map("referee_id")
  refereeSubHash   String    @unique @map("referee_sub_hash") // hashAppleSub(referee appleId||googleSub)
  code             String? // code used at signup, if any
  status           String    @default("PENDING") // PENDING -> QUALIFIED -> REWARDED -> EXPIRED
  // WHICH MECHANISM attributed this referral (invite-code onboarding spec, part
  // B). Plain string, not an enum, to match `status` in this same table and to
  // keep adding a mechanism a code-only change. Values and their SINGLE write
  // sites:
  //   provision_body     recordReferral, code came in the /auth/* body
  //   ip_fallback_exact  recordReferral, findLinkOpenReferralCode tier 1
  //   ip_fallback_net    recordReferral, findLinkOpenReferralCode tier 2
  //   redeem             redeemReferralCode (onboarding step / referral screen)
  //   repair             reserved for ops scripts — never written by app code
  // NULL = attributed before this column existed (no backfill by design).
  // Load-bearing beyond observability: redeemReferralCode reads it to decide
  // whether an explicit manual redeem may REPLACE a weak `ip_fallback_net`
  // guess (see that command) — so a wrong tier-2 match can never be permanent.
  source           String?
  sourceRaceId     String?   @map("source_race_id")
  qualifiedAt      DateTime? @map("qualified_at")
  qualifyingRaceId String?   @map("qualifying_race_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  referrer             User?                         @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: SetNull)
  referee              User                          @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  rewardGrants         ReferralRewardGrant[]
  qualificationIntents ReferralQualificationIntent[]
  raceActivities       ReferralRaceActivity[]
  qualifyingRace       Race?                         @relation("ReferralQualifyingRace", fields: [qualifyingRaceId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([referrerId, createdAt])
  @@index([referrerId, createdAt, id])
  @@index([referrerId, qualifiedAt])
  @@map("referrals")
}

// Exact event-time ownership for referral activity shown by the joined contest
// dashboard. A row is written only when a live referred user becomes ACCEPTED
// in a user-created race; later attribution changes never transfer it.
model ReferralRaceActivity {
  id                String   @id @default(uuid())
  referralId        String   @map("referral_id")
  referrerId        String?  @map("referrer_id")
  raceParticipantId String   @unique @map("race_participant_id")
  occurredAt        DateTime @map("occurred_at")
  createdAt         DateTime @default(now()) @map("created_at")

  referral        Referral        @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrer        User?           @relation("ReferralRaceActivityReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  raceParticipant RaceParticipant @relation(fields: [raceParticipantId], references: [id], onDelete: Cascade)

  @@index([referrerId, occurredAt, id])
  @@map("referral_race_activities")
}

// Durable qualification ownership is created in the race-settlement commit.
// Reward/review processing may retry later without changing the original fact.
model ReferralQualificationIntent {
  id                 String    @id @default(uuid())
  referralId         String?   @map("referral_id")
  referralFactId     String    @map("referral_fact_id")
  referrerIdSnapshot String?   @map("referrer_id_snapshot")
  qualifyingRaceId   String    @map("qualifying_race_id")
  qualifiedAt        DateTime  @map("qualified_at")
  processedAt        DateTime? @map("processed_at")
  attemptedAt        DateTime? @map("attempted_at")
  attemptCount       Int       @default(0) @map("attempt_count")
  lastError          String?   @map("last_error")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  referral           Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  qualifyingRace     Race      @relation("ReferralQualificationIntentRace", fields: [qualifyingRaceId], references: [id], onDelete: Restrict)

  @@unique([referralFactId, qualifyingRaceId])
  @@index([referrerIdSnapshot, processedAt, qualifiedAt])
  @@index([processedAt, qualifiedAt])
  @@map("referral_qualification_intents")
}

// Privacy-minimized immutable qualification ledger. It deliberately has no
// referee FK: ordinary Referral rows keep their shipped CASCADE deletion
// behavior while a settled contest fact survives as a provider HMAC plus the
// referrer's internal account link. No raw provider/network/device value is
// copied here.
model ReferralQualificationFact {
  id                  String   @id @default(uuid())
  referralFactId      String   @unique @map("referral_fact_id")
  referrerId          String?  @map("referrer_id")
  refereeIdentityHash String   @map("referee_identity_hash")
  attributionSource   String?  @map("attribution_source")
  qualifyingRaceId    String?  @map("qualifying_race_id")
  qualifiedAt         DateTime @map("qualified_at")
  referralCreatedAt   DateTime @default(now()) @map("referral_created_at")
  referrerWasReview   Boolean  @default(false) @map("referrer_was_review")
  refereeWasReview    Boolean  @default(false) @map("referee_was_review")
  status              String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  referrer            User?    @relation("ReferralQualificationFactReferrer", fields: [referrerId], references: [id], onDelete: SetNull)

  @@unique([refereeIdentityHash])
  @@index([referrerId, qualifiedAt])
  @@index([qualifyingRaceId])
  @@map("referral_qualification_facts")
}

model GiveawayContest {
