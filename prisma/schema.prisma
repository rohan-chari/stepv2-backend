  residencyConfirmedAt   DateTime?            @map("residency_confirmed_at")
  rulesAcceptedAt        DateTime             @map("rules_accepted_at")
  acceptedRulesVersion   String               @map("accepted_rules_version")
  acceptedRulesHash      String               @map("accepted_rules_hash")
