# Dependencies
node_modules/

# Environment variables
.env
.env.*

# Prisma generated client
/src/generated/prisma

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/

# EXCEPTION: the built marketing site IS committed. The documented rollback
# procedure (DEPLOYMENT.md) is `git checkout <tag> && npm install && pm2
# restart` with NO build step, so a build-artifact-only dist would leave
# barastep.com's /, /privacy and /support serving a stale page — or 500ing on a
# missing file — after any rollback. /privacy is the URL on the App Store
# listing. Build it locally (`cd web && npm run build`) and commit the result.
!web/dist/
!web/dist/**

# APNs certificates
certs/

# Prod DB dumps (BACKUP.md writes these to the repo root). They contain the
# full users table — PII must never enter git history.
*.dump

# Firebase service-account key (SECRET — local backend push testing only).
# Never commit; prod reads its own copy from outside the repo on the droplet.
bara-fcm-service-account.json
*-firebase-adminsdk-*.json
