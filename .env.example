# Example / documentation of runtime env vars. NOTE: `.env.*` is gitignored, so
# this file is a local reference only — copy values into the real `.env`.

# --- Database connection-pool budgets ---
# PM2 production values live in ecosystem.config.js so a reviewed reload
# reapplies them. Each value is a per-process maximum, not a shared total:
#   2 HTTP x 10 + 1 resolution x 8 + 1 cron x 4 = 32.
# Staging is one stopped-by-default `all` process with its own budget of 10.
# Every supplied value must be a canonical base-10 integer from 1 through 50.
# Deployment A deliberately omits production role values and retains the
# compatibility default of 20. Deployment B commits these exact values and
# then fails closed if its role-specific value is absent; the generic default
# is never a production substitute.
DATABASE_POOL_MAX_HTTP=10
DATABASE_POOL_MAX_RESOLUTION=8
DATABASE_POOL_MAX_CRON=4
DATABASE_POOL_MAX_ALL=10
# DATABASE_POOL_MAX_DEFAULT=20
DATABASE_POOL_TOTAL_BUDGET=32
# Optional for the two audited npm deploy/maintenance commands only. They use
# a bounded default of 2 when omitted; this override accepts only 1 through 5.
# DATABASE_POOL_MAX_MAINTENANCE=2
# DB_POOL_MAX is intentionally not an ordinary runtime setting. It is accepted
# only by the protected CAPACITY_MODE harness, whose target-isolation checks run
# before the pool is constructed.

# Absolute path to the root-owned, mode-0600 one-user OAuth secret used only for
# Gmail API feedback sends. The JSON contains clientId/clientSecret/refreshToken
# and must live outside this repository. Leave unset outside an explicitly
# configured environment; unrelated API routes still start normally.
# GOOGLE_WORKSPACE_FEEDBACK_OAUTH_FILE=/etc/bara/feedback-gmail-oauth.json
# See DEPLOYMENT.md → Google Workspace feedback Gmail API.

# --- Cron kill switches ---
# step_samples retention prune (Five-Minute Step Samples §4.1). SHIPPED DARK:
# keep this "true" on the initial prod deploy. Flip it (remove or set false) only
# AFTER the first run has been manually observed via its logged delete count.
# When "true" the cron is skipped entirely; when unset the cron RUNS by default.
STEP_SAMPLE_RETENTION_DISABLED=true

# --- App-funded prize pools (buy-ins removed) ---
# pool = playerCount x durationPoints(days: 1=1, 3=2, 7=4, 14=8) x PRIZE_COIN_UNIT,
# clamped to PRIZE_POOL_MAX_COINS per race (brackets keep their own tighter
# MAX_CHAMPION_PRIZE = 1000 ceiling). Both MUST be present on the droplet BEFORE
# the fundedPrizePoolsEnabled admin flag is flipped on, so the economy can be
# dialled down in minutes without an App Store release. Values below are the
# in-code defaults.
# 16,000 = the formula's maximum at the legal field cap (100 players x 8 points
# x 20), so it is non-binding for any race a user can create; it binds only on
# large seeded challenges, which is deliberate (batch 2026-07-27, item 7 / D3).
PRIZE_COIN_UNIT=20
PRIZE_POOL_MAX_COINS=16000

# --- Team race payout buff (batch 2026-08-08, item 5) ---
# A TEAM race multiplies the pool above by a per-duration-band factor, so a
# 14-day 5v5 winner takes 600 instead of 320. Individual races, seeded
# challenges and tournament brackets are NOT multiplied.
# The factor is STAMPED on the race row at creation (races.team_pool_mult_bps)
# and read back by projection AND settlement: editing these values reprices
# only races created afterwards — no in-flight race ever reprices mid-race, and
# a NULL stamp (any race created before this shipped) means 1.0 forever.
# PRIZE_POOL_MAX_COINS clamps the pool AFTER multiplication.
# Values below are the in-code defaults; a malformed/zero/negative value falls
# back to the default rather than zeroing a payout.
# Bands: SHORT = duration <= 3 days, MID = 4-7 days, LONG = >= 8 days.
TEAM_POOL_MULT_SHORT=1.0
TEAM_POOL_MULT_MID=1.5
TEAM_POOL_MULT_LONG=1.875

# --- Referral rewards ---
# Paid to each side when a referred user finishes their first QUALIFYING race.
# Both sides earn the same amount (owner decision D6, batch 2026-07-27; the
# referrer used to earn 1000). Served on the wire by GET /referrals/me and the
# public GET /referrals/:code preview, so app copy reads the live figures rather
# than hardcoding them — retune here + `pm2 reload`, no App Store release.
# Values below are the in-code defaults.
REFERRAL_REFERRER_COINS=500
REFERRAL_REFEREE_COINS=500

# Versioned, domain-specific HMAC for referral-contest entrant identity. Keep
# every version secret available until every contest accepted under it has aged
# through retention; rotate by adding V2 and changing ACTIVE_VERSION.
GIVEAWAY_ENTRANT_HMAC_ACTIVE_VERSION=1
GIVEAWAY_ENTRANT_HMAC_SECRET_V1=
# One-way protection for payment-provider confirmation references. Raw
# references are accepted for the request only and are never persisted.
GIVEAWAY_PROVIDER_REFERENCE_HMAC_SECRET=

# --- CDN-served art (remote assets) ---
# Origin used to build the absolute URLs served by GET /assets/manifest and the
# additive `assetUrl` fields on the shop catalogs. It must be the PUBLIC origin
# of THIS environment, because that is where its own /assets/<category>/<key>@
# <version>.png files are hosted. Defaults to the prod domain, so staging MUST
# set it explicitly or staging clients will download prod's art (and 404 on any
# asset that only exists in the staging deploy).
ASSET_BASE_URL=https://steptracker-api.org

# --- Powerup discard for coins (batch 2026-08-08 item 1) ---
# Max coins a single user can earn from discarding in-race powerups per LOCAL
# day (tz from users.timezone, default America/New_York). Prices themselves are
# NOT here — they live in balance config (discardPrices) so they are tunable
# from the admin screen without a deploy. A malformed value falls back to 40
# rather than reading as "no cap".
POWERUP_DISCARD_DAILY_COIN_CAP=40

# --- Race-results payout double rewarded ad (ships dark) ---
# Normal rollback disables preparation while leaving claim enabled for frozen
# pending entitlements. Both start false until staging verification.
ADS_RACE_PAYOUT_DOUBLE_PREPARE_ENABLED=false
ADS_RACE_PAYOUT_DOUBLE_CLAIM_ENABLED=false
# Exact comma-separated canonical ca-app-pub-<16 digits>/<10 digits> dedicated
# iOS + Android unit IDs. Empty or any malformed member disables the whole
# feature. Never reuse an extra-spin, coins, unlock, or box-reroll unit.
# iOS: ca-app-pub-4538901002392200/6376353967. Keep empty until Android exists.
ADMOB_RACE_PAYOUT_DOUBLE_AD_UNIT_IDS=
# Only integers 1..100 are accepted; malformed or larger values fall back to 100.
RACE_PAYOUT_DOUBLE_MAX_BONUS_COINS=100
# Default-off five-minute Postgres reconciliation/automatic rollout-stop job.
RACE_PAYOUT_DOUBLE_RECONCILE_ENABLED=false
